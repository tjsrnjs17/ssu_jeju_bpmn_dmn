<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_AP" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="AP_Collaboration" name="01 공지·신청·본교 추천·제주대 선발 / 최종 As-Is">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:participant id="AP_S" name="학생" processRef="AP_S_process" />
    <bpmn:participant id="AP_H" name="본교 · 숭실대학교" processRef="AP_H_process" />
    <bpmn:participant id="AP_J" name="교류대 · 제주대학교" processRef="AP_J_process" />
    <bpmn:messageFlow id="AP_m1" name="모집 공고 조회" sourceRef="AP_hPublish" targetRef="AP_s2" />
    <bpmn:messageFlow id="AP_m2" name="승인·재서명 요청" sourceRef="AP_s3" targetRef="AP_h0" />
    <bpmn:messageFlow id="AP_m3" name="검토 결과·서명자료" sourceRef="AP_h5" targetRef="AP_s4" />
    <bpmn:messageFlow id="AP_m4" name="학과 제출" sourceRef="AP_sDept" targetRef="AP_hDept0" />
    <bpmn:messageFlow id="AP_m5" name="LMS 신청자료" sourceRef="AP_s6" targetRef="AP_h8" />
    <bpmn:messageFlow id="AP_m6" name="누락·정정 연락" sourceRef="AP_hContact" targetRef="AP_sReview" />
    <bpmn:messageFlow id="AP_m7" name="보완 제출" sourceRef="AP_sFix" targetRef="AP_hCorrection" />
    <bpmn:messageFlow id="AP_m8" name="추천 공문·명단" sourceRef="AP_h17" targetRef="AP_j0" />
    <bpmn:messageFlow id="AP_m9" name="선발 공문" sourceRef="AP_j2" targetRef="AP_h18" />
    <bpmn:messageFlow id="AP_m10" name="홈페이지 공고 조회" sourceRef="AP_j2" targetRef="AP_s7" />
    <bpmn:textAnnotation id="AP_note1">
      <bpmn:text>인터뷰 Q1·Q19 | 두 제출 경로를 교차 확인하고 누락 자료는 보완한다.
이수구분 오류는 정정·재서명 후 다시 점검한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="AP_note2">
      <bpmn:text>인터뷰 Q2–5·Q20 | 이수구분 판단은 학과장, 전달은 조교, 2차 점검은 학사팀.
일반선택의 무승인 통과는 개선 아이디어이며 현행 절차가 아니다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="AP_note3">
      <bpmn:text>추천은 대학별 일괄 취합. 선발 공지는 2026 여름 제주대 안내를 적용.
문서상 추천 결재는 보완 근거로 유지하며 추가 방문을 가정하지 않는다.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="AP_S_process" name="01 공지·신청·본교 추천·제주대 선발 / 최종 As-Is / 학생" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="AP_S_lanes">
      <bpmn:lane id="AP_S_lane0" name="신청자">
        <bpmn:flowNodeRef>AP_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sDept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_sPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_s9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AP_s0" name="교류 공고 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>AP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="AP_s2" name="개설과목 확인&#10;신청서·대응 과목 작성">
      <bpmn:documentation>근거: S01; W02; I20261113 학사팀 학점교류 담당자 인터뷰 Q2</bpmn:documentation>
      <bpmn:incoming>AP_f1</bpmn:incoming>
      <bpmn:outgoing>AP_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="AP_s3" name="학과장 승인·서명 요청">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q2·Q20</bpmn:documentation>
      <bpmn:incoming>AP_f2</bpmn:incoming>
      <bpmn:incoming>AP_f13</bpmn:incoming>
      <bpmn:outgoing>AP_f3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="AP_s4" name="학과장 검토·서명&#10;결과 확인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q2</bpmn:documentation>
      <bpmn:incoming>AP_f3</bpmn:incoming>
      <bpmn:outgoing>AP_f4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="AP_s5" name="학과 승인 결과?" default="AP_f6">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f4</bpmn:incoming>
      <bpmn:outgoing>AP_f5</bpmn:outgoing>
      <bpmn:outgoing>AP_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="AP_sDept" name="서명된 신청서&#10;학과에 최종 제출">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q1·Q2</bpmn:documentation>
      <bpmn:incoming>AP_f5</bpmn:incoming>
      <bpmn:outgoing>AP_f7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="AP_s6" name="엑셀·서명 스캔·&#10;추가서류 LMS 업로드">
      <bpmn:documentation>근거: W02 3.다; I20261113 학사팀 학점교류 담당자 인터뷰 Q1
학과 제출과 LMS 제출은 둘 다 필요하다.</bpmn:documentation>
      <bpmn:incoming>AP_f7</bpmn:incoming>
      <bpmn:outgoing>AP_f8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="AP_sCorrect" name="이수구분·신청서 정정">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q19
학과장 재서명을 받은 뒤 수정본을 제출한다.</bpmn:documentation>
      <bpmn:incoming>AP_f12</bpmn:incoming>
      <bpmn:outgoing>AP_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="AP_f1" sourceRef="AP_s0" targetRef="AP_s2" />
    <bpmn:sequenceFlow id="AP_f2" sourceRef="AP_s2" targetRef="AP_s3" />
    <bpmn:sequenceFlow id="AP_f13" name="재서명 요청" sourceRef="AP_sCorrect" targetRef="AP_s3" />
    <bpmn:sequenceFlow id="AP_f3" sourceRef="AP_s3" targetRef="AP_s4" />
    <bpmn:sequenceFlow id="AP_f4" sourceRef="AP_s4" targetRef="AP_s5" />
    <bpmn:sequenceFlow id="AP_f5" name="승인" sourceRef="AP_s5" targetRef="AP_sDept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">승인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f6" name="미승인" sourceRef="AP_s5" targetRef="AP_s10" />
    <bpmn:sequenceFlow id="AP_f7" sourceRef="AP_sDept" targetRef="AP_s6" />
    <bpmn:sequenceFlow id="AP_f8" sourceRef="AP_s6" targetRef="AP_sReview" />
    <bpmn:sequenceFlow id="AP_f11" name="보완 제출 후" sourceRef="AP_sFix" targetRef="AP_sReview" />
    <bpmn:sequenceFlow id="AP_f17" name="결과 확인 후" sourceRef="AP_sPending" targetRef="AP_sReview" />
    <bpmn:sequenceFlow id="AP_f9" sourceRef="AP_sReview" targetRef="AP_sIssue" />
    <bpmn:sequenceFlow id="AP_f10" name="자료·제출 누락" sourceRef="AP_sIssue" targetRef="AP_sFix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">자료·제출 누락</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f12" name="이수구분 정정" sourceRef="AP_sIssue" targetRef="AP_sCorrect">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">이수구분 정정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f14" name="추천 완료" sourceRef="AP_sIssue" targetRef="AP_s7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">추천 완료</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f15" name="미추천 확정" sourceRef="AP_sIssue" targetRef="AP_s11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">미추천 확정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f16" name="결과 대기" sourceRef="AP_sIssue" targetRef="AP_sPending" />
    <bpmn:sequenceFlow id="AP_f18" sourceRef="AP_s7" targetRef="AP_s8" />
    <bpmn:sequenceFlow id="AP_f19" name="선발" sourceRef="AP_s8" targetRef="AP_s9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">선발</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f20" name="미선발" sourceRef="AP_s8" targetRef="AP_s11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">미선발</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AP_f21" name="미발표" sourceRef="AP_s8" targetRef="AP_sPending" />
    <bpmn:endEvent id="AP_s10" name="학과 미승인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="AP_sReview" name="신청 처리·보완 요청 확인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q1·Q19</bpmn:documentation>
      <bpmn:incoming>AP_f8</bpmn:incoming>
      <bpmn:incoming>AP_f11</bpmn:incoming>
      <bpmn:incoming>AP_f17</bpmn:incoming>
      <bpmn:outgoing>AP_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AP_sIssue" name="신청 처리 상태?" default="AP_f16">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f9</bpmn:incoming>
      <bpmn:outgoing>AP_f10</bpmn:outgoing>
      <bpmn:outgoing>AP_f12</bpmn:outgoing>
      <bpmn:outgoing>AP_f14</bpmn:outgoing>
      <bpmn:outgoing>AP_f15</bpmn:outgoing>
      <bpmn:outgoing>AP_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="AP_sFix" name="누락 자료 보완&#10;해당 제출처에 재제출">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q1
누락된 제출처·자료를 보완한다. 모든 신청을 처음부터 재작성하지 않는다.</bpmn:documentation>
      <bpmn:incoming>AP_f10</bpmn:incoming>
      <bpmn:outgoing>AP_f11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="AP_s7" name="제주대 선발 공고·&#10;학번 확인">
      <bpmn:documentation>근거: S04 P009–013
2026 여름 제주대는 홈페이지와 소속대학 공문으로 안내하며 개별 통지하지 않는다.</bpmn:documentation>
      <bpmn:incoming>AP_f14</bpmn:incoming>
      <bpmn:outgoing>AP_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AP_s8" name="제주대 선발?" default="AP_f21">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f18</bpmn:incoming>
      <bpmn:outgoing>AP_f19</bpmn:outgoing>
      <bpmn:outgoing>AP_f20</bpmn:outgoing>
      <bpmn:outgoing>AP_f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AP_s11" name="미추천·미선발 확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f15</bpmn:incoming>
      <bpmn:incoming>AP_f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="AP_sPending" name="처리 결과 확인 대기">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q1</bpmn:documentation>
      <bpmn:incoming>AP_f16</bpmn:incoming>
      <bpmn:incoming>AP_f21</bpmn:incoming>
      <bpmn:outgoing>AP_f17</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="AP_sPending_condition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">본교 신청 처리 결과 또는 제주대 선발 결과가 확인됨</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="AP_s9" name="02 수강신청으로">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>AP_f19</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="AP_H_process" name="01 공지·신청·본교 추천·제주대 선발 / 최종 As-Is / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="AP_H_lanes">
      <bpmn:lane id="AP_H_lane2" name="학사팀 · 학점교류 담당">
        <bpmn:flowNodeRef>AP_h8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_h2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_h9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_hContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_hCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_hBatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_hApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_h17</bpmn:flowNodeRef>
