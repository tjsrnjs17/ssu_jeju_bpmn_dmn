        </bpmn:inputSet>
        <bpmn:outputSet id="AP_DeptIn_outputs" />
      </bpmn:ioSpecification>
      <bpmn:property id="Property_177a6ca" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="AP_DeptCompare">
