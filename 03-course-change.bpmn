<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_CH" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="CH_Collaboration" name="03 변경 과목 재신청·재승인">
    <bpmn:documentation>As-Is 규정 모델. 03 변경 과목 재신청·재승인
내규에 따라 변경 과목을 등록하기 전에 재신청하고 승인받는다. 변경 과목의 학점인정과 신청서 문구의 적용 범위는 I15에서 확인한다.
주황색은 담당자의 승인 또는 판단 단계. I번호 주석은 인터뷰 확인 사항. 참고 BPMN은 근거에서 제외.</bpmn:documentation>
    <bpmn:participant id="CH_S" name="학생" processRef="CH_S_process" />
    <bpmn:participant id="CH_H" name="본교 · 숭실대학교" processRef="CH_H_process" />
    <bpmn:participant id="CH_J" name="교류대 · 제주대학교" processRef="CH_J_process" />
    <bpmn:messageFlow id="CH_m1" name="변경 신청서" sourceRef="CH_s3" targetRef="CH_h0" />
    <bpmn:messageFlow id="CH_m2" name="재승인 결과" sourceRef="CH_h7" targetRef="CH_s6" />
    <bpmn:messageFlow id="CH_m3" name="승인 과목 신청" sourceRef="CH_s8" targetRef="CH_j0" />
    <bpmn:messageFlow id="CH_m4" name="실제 등록 결과" sourceRef="CH_j1" targetRef="CH_s8" />
    <bpmn:textAnnotation id="CH_h7_InterviewNote">
      <bpmn:text>I15 · 인터뷰 확인
수강신청 전에 본교 재승인을 받은 변경 과목은 학점인정이 
가능한가요? 신청서의 변경 과목 불인정 문구는 어떤 경우에 
적용되나요?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CH_h7_InterviewNote_association" associationDirection="None" sourceRef="CH_h7" targetRef="CH_h7_InterviewNote" />
  </bpmn:collaboration>
  <bpmn:process id="CH_S_process" name="03 변경 과목 재신청·재승인 / 학생" isExecutable="false">
    <bpmn:documentation>내규에 따라 변경 과목을 등록하기 전에 재신청하고 승인받는다. 변경 과목의 학점인정과 신청서 문구의 적용 범위는 I15에서 확인한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="CH_S_lanes">
      <bpmn:lane id="CH_S_lane0" name="과목 변경 신청자">
        <bpmn:flowNodeRef>CH_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CH_s0" name="폐강·추가·과목 변경">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="CH_s1" name="변경 과목 등록 전?" default="CH_f4">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f1</bpmn:incoming>
      <bpmn:outgoing>CH_f2</bpmn:outgoing>
      <bpmn:outgoing>CH_f3</bpmn:outgoing>
      <bpmn:outgoing>CH_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CH_s2" name="변경 신청서·&#10;대응 과목 다시 작성">
      <bpmn:documentation>근거: W01 제11조제2항; S01; W02 4.나.4</bpmn:documentation>
      <bpmn:incoming>CH_f2</bpmn:incoming>
      <bpmn:outgoing>CH_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="CH_s3" name="소속 학과에&#10;변경 신청서 제출">
      <bpmn:documentation>근거: W01 제5·6·11조</bpmn:documentation>
      <bpmn:incoming>CH_f5</bpmn:incoming>
      <bpmn:outgoing>CH_f6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="CH_s6" name="재승인·기한 결과 확인">
      <bpmn:documentation>근거: W01 제11조; S04 P034–039
DMN 참조: D05 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)</bpmn:documentation>
      <bpmn:incoming>CH_f6</bpmn:incoming>
      <bpmn:outgoing>CH_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CH_s7" name="승인 + 신청기간 내?" default="CH_f9">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f7</bpmn:incoming>
      <bpmn:outgoing>CH_f8</bpmn:outgoing>
      <bpmn:outgoing>CH_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CH_s8" name="승인된 변경 과목만&#10;제주대 수강신청">
      <bpmn:documentation>근거: W01 제11조; S04 P034–039</bpmn:documentation>
      <bpmn:incoming>CH_f8</bpmn:incoming>
      <bpmn:outgoing>CH_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CH_s9" name="02 실제 등록 결과로">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CH_f1" sourceRef="CH_s0" targetRef="CH_s1" />
    <bpmn:sequenceFlow id="CH_f2" name="등록 전" sourceRef="CH_s1" targetRef="CH_s2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">등록 전</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f3" name="사전 승인 없이 이미 등록" sourceRef="CH_s1" targetRef="CH_s5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">사전 승인 없이 이미 등록</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f4" name="사실 미확정" sourceRef="CH_s1" targetRef="CH_s11" />
    <bpmn:sequenceFlow id="CH_f5" sourceRef="CH_s2" targetRef="CH_s3" />
    <bpmn:sequenceFlow id="CH_f6" sourceRef="CH_s3" targetRef="CH_s6" />
    <bpmn:sequenceFlow id="CH_f7" sourceRef="CH_s6" targetRef="CH_s7" />
    <bpmn:sequenceFlow id="CH_f8" name="둘 다 확인" sourceRef="CH_s7" targetRef="CH_s8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">둘 다 확인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f9" name="그 외" sourceRef="CH_s7" targetRef="CH_s10" />
    <bpmn:sequenceFlow id="CH_f10" sourceRef="CH_s8" targetRef="CH_s9" />
    <bpmn:endEvent id="CH_s5" name="사전 승인 없는 등록&#10;인정 대상 제외">
      <bpmn:documentation>근거: S01 C30; W01 제11조</bpmn:documentation>
      <bpmn:incoming>CH_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CH_s11" name="등록·승인 사실 미확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CH_s10" name="변경 불가·미확정&#10;원래 과목/취소 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="CH_H_process" name="03 변경 과목 재신청·재승인 / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>내규에 따라 변경 과목을 등록하기 전에 재신청하고 승인받는다. 변경 과목의 학점인정과 신청서 문구의 적용 범위는 I15에서 확인한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="CH_H_lanes">
      <bpmn:lane id="CH_H_lane2" name="학사팀·교무처장·총장 승인">
        <bpmn:flowNodeRef>CH_h7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CH_H_lane1" name="단과대학·대학장">
        <bpmn:flowNodeRef>CH_h6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CH_H_lane0" name="학과·학과장">
        <bpmn:flowNodeRef>CH_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h4g</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CH_h0" name="변경 신청 접수">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CH_h0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="CH_h4" name="변경 과목 심사&#10;학과장 확인·서명">
      <bpmn:documentation>근거: W01 제5·6·9·10·11조; W02 4.가
DMN 참조: D02 D03 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)
담당 판단·승인: G03. 세부 적용 기준은 해당 규정과 자료에서 확인한다.</bpmn:documentation>
      <bpmn:incoming>CH_f11</bpmn:incoming>
      <bpmn:outgoing>CH_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CH_h5" name="LMS 등 재제출 자료 확인">
      <bpmn:documentation>근거: W01 제11조; W02 3.다·4.나.4
DMN 참조: D04 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)
기존 학과 제출 및 LMS 절차를 따른다.</bpmn:documentation>
      <bpmn:incoming>CH_f12</bpmn:incoming>
      <bpmn:outgoing>CH_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CH_h4g" name="재신청 요건 충족?" default="CH_f14">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f13</bpmn:incoming>
      <bpmn:outgoing>CH_f14</bpmn:outgoing>
      <bpmn:outgoing>CH_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CH_h6" name="대학장 확인·날인&#10;교무처장에 제출">
      <bpmn:documentation>근거: W01 제5·6·11조
담당 판단·승인: G03. 세부 적용 기준은 해당 규정과 자료에서 확인한다.</bpmn:documentation>
      <bpmn:incoming>CH_f15</bpmn:incoming>
      <bpmn:outgoing>CH_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CH_h7" name="교무처장 경유&#10;총장 재승인 판단">
      <bpmn:documentation>근거: W01 제6·11조
담당 판단·승인: G03. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
실제 승인 결과를 학생의 수강신청 조건에 사용한다.</bpmn:documentation>
      <bpmn:incoming>CH_f16</bpmn:incoming>
      <bpmn:outgoing>CH_f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="CH_f11" sourceRef="CH_h0" targetRef="CH_h4" />
    <bpmn:sequenceFlow id="CH_f14" name="미충족·미확정" sourceRef="CH_h4g" targetRef="CH_h3" />
    <bpmn:sequenceFlow id="CH_f12" sourceRef="CH_h4" targetRef="CH_h5" />
    <bpmn:sequenceFlow id="CH_f13" sourceRef="CH_h5" targetRef="CH_h4g" />
    <bpmn:sequenceFlow id="CH_f15" name="충족" sourceRef="CH_h4g" targetRef="CH_h6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">충족</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f16" sourceRef="CH_h6" targetRef="CH_h7" />
    <bpmn:sequenceFlow id="CH_f17" sourceRef="CH_h7" targetRef="CH_h8" />
    <bpmn:endEvent id="CH_h3" name="재신청 요건 미충족&#10;또는 미확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CH_h8" name="재승인 결과 반환">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f17</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="CH_J_process" name="03 변경 과목 재신청·재승인 / 교류대 · 제주대학교" isExecutable="false">
    <bpmn:documentation>내규에 따라 변경 과목을 등록하기 전에 재신청하고 승인받는다. 변경 과목의 학점인정과 신청서 문구의 적용 범위는 I15에서 확인한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="CH_J_lanes">
      <bpmn:lane id="CH_J_lane0" name="수강 담당">
        <bpmn:flowNodeRef>CH_j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_j2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CH_j0" name="변경 수강신청">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CH_j0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="CH_j1" name="기한·좌석·제한 확인&#10;등록 결과 반영">
      <bpmn:documentation>근거: S04 P021–029·P034–039
추가기간 5/28 10시–5/29 18시. 승인만으로 선착순 좌석을 보장하지 않음. 이후 추가기간 없음.</bpmn:documentation>
      <bpmn:incoming>CH_f18</bpmn:incoming>
      <bpmn:outgoing>CH_f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CH_j2" name="등록 성공/실패 반환">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CH_f18" sourceRef="CH_j0" targetRef="CH_j1" />
    <bpmn:sequenceFlow id="CH_f19" sourceRef="CH_j1" targetRef="CH_j2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="CH_Diagram" name="03 변경 과목 재신청·재승인">
    <bpmndi:BPMNPlane id="CH_Plane" bpmnElement="CH_Collaboration">
      <bpmndi:BPMNShape id="CH_S_di" bpmnElement="CH_S" isHorizontal="true" bioc:stroke="#475569" bioc:fill="#ffffff">
        <dc:Bounds x="150" y="80" width="3692" height="365" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CH_S_lane0_di" bpmnElement="CH_S_lane0" isHorizontal="true">
