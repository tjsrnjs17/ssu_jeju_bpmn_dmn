<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_CH" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="CH_Collaboration" name="03 변경 과목 재신청·재승인 / 최종 As-Is">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:participant id="CH_S" name="학생" processRef="CH_S_process" />
    <bpmn:participant id="CH_H" name="본교 · 숭실대학교" processRef="CH_H_process" />
    <bpmn:participant id="CH_J" name="교류대 · 제주대학교" processRef="CH_J_process" />
    <bpmn:messageFlow id="CH_m1" name="변경 신청자료" sourceRef="CH_s3" targetRef="CH_h0" />
    <bpmn:messageFlow id="CH_m2" name="사전 변경 결과" sourceRef="CH_hPreApproval" targetRef="CH_s6" />
    <bpmn:messageFlow id="CH_m3" name="변경 수강신청" sourceRef="CH_s8" targetRef="CH_j0" />
    <bpmn:messageFlow id="CH_m4" name="등록 성공·실패" sourceRef="CH_j1" targetRef="CH_s8" />
    <bpmn:messageFlow id="CH_m5" name="변경 사실 설명" sourceRef="CH_sPostInfo" targetRef="CH_hPost0" />
    <bpmn:messageFlow id="CH_m6" name="재승인 요청 안내" sourceRef="CH_hPostRequest" targetRef="CH_sPostReq" />
    <bpmn:messageFlow id="CH_m7" name="실제 과목·대응자료" sourceRef="CH_sPostReq" targetRef="CH_hPostReview" />
    <bpmn:messageFlow id="CH_m8" name="확정 이수구분·인정 결과" sourceRef="CH_hPostReply" targetRef="CH_sPostResult" />
  </bpmn:collaboration>
  <bpmn:process id="CH_S_process" name="03 변경 과목 재신청·재승인 / 최종 As-Is / 학생" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="CH_S_lanes">
      <bpmn:lane id="CH_S_lane0" name="과목 변경·재승인 요청자">
        <bpmn:flowNodeRef>CH_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_sPostInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_sPostReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_sPostResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_sPostEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_sWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_s8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CH_s0" name="과목 변경 필요·발견">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="CH_s1" name="처리 시점?" default="CH_f3">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f1</bpmn:incoming>
      <bpmn:outgoing>CH_f2</bpmn:outgoing>
      <bpmn:outgoing>CH_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CH_s2" name="변경 신청서·&#10;대응 과목 다시 작성">
      <bpmn:documentation>근거: W01 제11조제2항; S01; W02 4.나.4</bpmn:documentation>
      <bpmn:incoming>CH_f2</bpmn:incoming>
      <bpmn:outgoing>CH_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="CH_s3" name="소속 학과에&#10;변경 신청서 제출">
      <bpmn:documentation>근거: W01 제5·6·11조</bpmn:documentation>
      <bpmn:incoming>CH_f4</bpmn:incoming>
      <bpmn:outgoing>CH_f5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="CH_s6" name="재승인·기한 결과 확인">
      <bpmn:documentation>근거: W01 제11조; S04 P034–039
DMN 참조: D05 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)</bpmn:documentation>
      <bpmn:incoming>CH_f5</bpmn:incoming>
      <bpmn:incoming>CH_f10</bpmn:incoming>
      <bpmn:outgoing>CH_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CH_s7" name="승인 + 신청기간 내?" default="CH_f9">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f6</bpmn:incoming>
      <bpmn:outgoing>CH_f7</bpmn:outgoing>
      <bpmn:outgoing>CH_f8</bpmn:outgoing>
      <bpmn:outgoing>CH_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CH_s9" name="02 실제 등록 결과로">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="CH_sPostInfo" name="변경 사실·실제 수강과목&#10;학사팀에 확인·설명">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q10
학생 연락 또는 성적 대조 후 학사팀의 연락으로 과목 변경이 확인된다. 본교 미통보 동안에는 이 경로가 시작되지 않는다.</bpmn:documentation>
      <bpmn:incoming>CH_f3</bpmn:incoming>
      <bpmn:outgoing>CH_f12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="CH_sPostReq" name="실제 이수과목의&#10;이수구분 재승인 요청">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q10·Q11</bpmn:documentation>
      <bpmn:incoming>CH_f12</bpmn:incoming>
      <bpmn:outgoing>CH_f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="CH_sPostResult" name="재승인 결과 확인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q11</bpmn:documentation>
      <bpmn:incoming>CH_f13</bpmn:incoming>
      <bpmn:outgoing>CH_f14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="CH_sPostEnd" name="06 인정·성적 처리 재개&#10;수학 중이면 해당 단계 복귀">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q10·Q11</bpmn:documentation>
      <bpmn:incoming>CH_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CH_sWait" name="승인 결과·신청기간 대기">
      <bpmn:documentation>근거: W01 제11조; S04 신청기간</bpmn:documentation>
      <bpmn:incoming>CH_f9</bpmn:incoming>
      <bpmn:outgoing>CH_f10</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CH_sWait_condition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">승인 결과와 적용 신청기간이 확인됨</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="CH_f1" sourceRef="CH_s0" targetRef="CH_s1" />
    <bpmn:sequenceFlow id="CH_f2" name="수강신청 전" sourceRef="CH_s1" targetRef="CH_s2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">수강신청 전</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f3" name="이미 등록·이수 후" sourceRef="CH_s1" targetRef="CH_sPostInfo" />
    <bpmn:sequenceFlow id="CH_f4" sourceRef="CH_s2" targetRef="CH_s3" />
    <bpmn:sequenceFlow id="CH_f5" sourceRef="CH_s3" targetRef="CH_s6" />
    <bpmn:sequenceFlow id="CH_f10" sourceRef="CH_sWait" targetRef="CH_s6" />
    <bpmn:sequenceFlow id="CH_f6" sourceRef="CH_s6" targetRef="CH_s7" />
    <bpmn:sequenceFlow id="CH_f7" name="승인·기간 내" sourceRef="CH_s7" targetRef="CH_s8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">승인·기간 내</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f8" name="불승인·기한 경과" sourceRef="CH_s7" targetRef="CH_s10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">불승인·기한 경과</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f9" name="결과 미확인·기간 전" sourceRef="CH_s7" targetRef="CH_sWait" />
    <bpmn:sequenceFlow id="CH_f11" sourceRef="CH_s8" targetRef="CH_s9" />
    <bpmn:sequenceFlow id="CH_f12" sourceRef="CH_sPostInfo" targetRef="CH_sPostReq" />
    <bpmn:sequenceFlow id="CH_f13" sourceRef="CH_sPostReq" targetRef="CH_sPostResult" />
    <bpmn:sequenceFlow id="CH_f14" sourceRef="CH_sPostResult" targetRef="CH_sPostEnd" />
    <bpmn:endEvent id="CH_s10" name="변경 불가·결과 확인&#10;02 기존 등록 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CH_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CH_s8" name="승인된 변경 과목만&#10;제주대 수강신청">
      <bpmn:documentation>근거: W01 제11조; S04 P034–039</bpmn:documentation>
      <bpmn:incoming>CH_f7</bpmn:incoming>
      <bpmn:outgoing>CH_f11</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="CH_H_process" name="03 변경 과목 재신청·재승인 / 최종 As-Is / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="CH_H_lanes">
      <bpmn:lane id="CH_H_lane1" name="학사팀 · 학점교류 담당">
        <bpmn:flowNodeRef>CH_hPost0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPostRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPreFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h4g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPreApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPreEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPostRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPostReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPostEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CH_H_lane0" name="학과장 · 이수구분 심사">
        <bpmn:flowNodeRef>CH_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_hPostReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CH_h4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CH_h0" name="변경 신청 접수">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CH_h0_message" />
    </bpmn:startEvent>
    <bpmn:startEvent id="CH_hPost0" name="사후 변경 사실 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CH_f22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CH_hPost0_message" />
    </bpmn:startEvent>
    <bpmn:sendTask id="CH_hPostRequest" name="학생에게 이수구분&#10;재승인 요청 안내">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q10</bpmn:documentation>
      <bpmn:incoming>CH_f22</bpmn:incoming>
      <bpmn:outgoing>CH_f23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="CH_hPostReview" name="실제 이수과목 심사&#10;이수구분 재승인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q10·Q11
담당 판단·승인: 학과장 전문 판단. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
인터뷰 우선: 성적 수신 전후에 변경을 발견해도 재승인 후 인정하는 실제 경로를 반영한다. 유사성 판단 후 전공·교양 또는 일반선택 결과를 결정한다. 사전승인 부재만으로 불인정하지 않는다.</bpmn:documentation>
      <bpmn:incoming>CH_f23</bpmn:incoming>
      <bpmn:outgoing>CH_f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="CH_f15" sourceRef="CH_h0" targetRef="CH_h4" />
    <bpmn:sequenceFlow id="CH_f16" sourceRef="CH_h4" targetRef="CH_h5" />
    <bpmn:sequenceFlow id="CH_f22" sourceRef="CH_hPost0" targetRef="CH_hPostRequest" />
    <bpmn:sequenceFlow id="CH_f23" sourceRef="CH_hPostRequest" targetRef="CH_hPostReview" />
    <bpmn:sequenceFlow id="CH_f24" sourceRef="CH_hPostReview" targetRef="CH_hPostRecord" />
    <bpmn:userTask id="CH_h4" name="변경 과목 이수구분&#10;학과장 심사·서명">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q2–5·Q10·Q11
DMN 참조: D02 D03 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)
담당 판단·승인: 담당자 판단. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
학과장이 실제 교과과정과 유사성을 판단한다. 대응 전공·교양으로 인정되지 않으면 일반선택 여부를 심사한다. 일반선택도 자동 승인하지 않는다.</bpmn:documentation>
      <bpmn:incoming>CH_f15</bpmn:incoming>
      <bpmn:outgoing>CH_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="CH_f21" sourceRef="CH_hPreApproval" targetRef="CH_hPreEnd" />
    <bpmn:sequenceFlow id="CH_f18" name="요건 준비" sourceRef="CH_h4g" targetRef="CH_hPreApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">요건 준비</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CH_f19" name="누락·확인 필요" sourceRef="CH_h4g" targetRef="CH_hPreFix" />
    <bpmn:sequenceFlow id="CH_f17" sourceRef="CH_h5" targetRef="CH_h4g" />
