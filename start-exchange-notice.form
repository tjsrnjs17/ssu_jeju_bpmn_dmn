{
  "id": "CampusLinksStartExchangeNoticeForm",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "schemaVersion": 18,
  "components": [
    {
      "type": "textfield",
      "id": "Homepage",
      "key": "homepageUrl",
      "label": "교류대 공식 대표 홈페이지",
      "defaultValue": "https://www.korea.ac.kr/",
      "description": "실습 예시는 고려대학교이며, 다른 교류대의 공식 대표 주소도 입력할 수 있다.",
      "validate": {
        "required": true,
        "pattern": "^https://([a-zA-Z0-9-]+[.])+[a-zA-Z]{2,}/?$"
      }
    },
    {
      "type": "textfield",
      "id": "Term",
      "key": "term",
      "label": "대상 학년도·학기",
      "description": "예: 2026학년도 여름 계절학기",
      "validate": {
        "required": true
      },
      "defaultValue": "2026학년도 여름계절학기"
    }
  ]
}
