<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_OV" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="OV_Collaboration" name="00 전체 흐름">
    <bpmn:documentation>As-Is 규정 모델. 00 전체 흐름
정상 완료 경로의 개요. 분기·반려·변경·공결·취소·성적 지연은 01–06 상세 파일에서 확인한다. 각 상자는 해당 상세 절차를 요약한다.
주황색은 담당자의 승인 또는 판단 단계. I번호 주석은 인터뷰 확인 사항. 참고 BPMN은 근거에서 제외.</bpmn:documentation>
    <bpmn:participant id="OV_S" name="학생" processRef="OV_S_process" />
    <bpmn:participant id="OV_H" name="본교 · 숭실대학교" processRef="OV_H_process" />
    <bpmn:participant id="OV_J" name="교류대 · 제주대학교" processRef="OV_J_process" />
    <bpmn:messageFlow id="OV_m1" name="신청 자료" sourceRef="OV_s1" targetRef="OV_h0" />
    <bpmn:messageFlow id="OV_m2" name="추천 공문·명단" sourceRef="OV_h2" targetRef="OV_j0" />
    <bpmn:messageFlow id="OV_m3" name="홈페이지 조회" sourceRef="OV_j1" targetRef="OV_s2" />
    <bpmn:messageFlow id="OV_m4" name="신청·납부" sourceRef="OV_s3" targetRef="OV_j2" />
    <bpmn:messageFlow id="OV_m5" name="수업·시험·공결" sourceRef="OV_s4" targetRef="OV_j3" />
    <bpmn:messageFlow id="OV_m6" name="공식 성적" sourceRef="OV_j4" targetRef="OV_h4" />
    <bpmn:messageFlow id="OV_m7" name="본교 반영 결과" sourceRef="OV_h5" targetRef="OV_s5" />
  </bpmn:collaboration>
  <bpmn:process id="OV_S_process" name="00 전체 흐름 / 학생" isExecutable="false">
    <bpmn:documentation>정상 완료 경로의 개요. 분기·반려·변경·공결·취소·성적 지연은 01–06 상세 파일에서 확인한다. 각 상자는 해당 상세 절차를 요약한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="OV_S_lanes">
      <bpmn:lane id="OV_S_lane0" name="교류 신청·수학">
        <bpmn:flowNodeRef>OV_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_s6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OV_s0" name="교류 희망">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>OV_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="OV_s1" name="01 공지 확인·신청&#10;학과 제출 → LMS">
      <bpmn:documentation>근거: S01; W02 2·3</bpmn:documentation>
      <bpmn:incoming>OV_f1</bpmn:incoming>
      <bpmn:outgoing>OV_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_s2" name="02 선발·학번 확인&#10;승인 과목 수강신청">
      <bpmn:documentation>근거: S04 P009–039; W01 제11조</bpmn:documentation>
      <bpmn:incoming>OV_f2</bpmn:incoming>
      <bpmn:outgoing>OV_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_s3" name="02 수강료 납부&#10;폐강·변경 확인">
      <bpmn:documentation>근거: S04 P040–047
변경은 03, 취소는 05 상세. 미납·폐강을 임의로 정상 완료 처리하지 않는다.</bpmn:documentation>
      <bpmn:incoming>OV_f3</bpmn:incoming>
      <bpmn:outgoing>OV_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_s4" name="04 수업·시험&#10;필요시 공결·시설 이용">
      <bpmn:documentation>근거: S04 P048–061·P118–126</bpmn:documentation>
      <bpmn:incoming>OV_f4</bpmn:incoming>
      <bpmn:outgoing>OV_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_s5" name="06 성적열람·이의신청&#10;본교 인정 결과 확인">
      <bpmn:documentation>근거: S04 P062–069; W01 제13조</bpmn:documentation>
      <bpmn:incoming>OV_f5</bpmn:incoming>
      <bpmn:outgoing>OV_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="OV_s6" name="수학·인정 결과 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>OV_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="OV_f1" sourceRef="OV_s0" targetRef="OV_s1" />
    <bpmn:sequenceFlow id="OV_f2" sourceRef="OV_s1" targetRef="OV_s2" />
    <bpmn:sequenceFlow id="OV_f3" sourceRef="OV_s2" targetRef="OV_s3" />
    <bpmn:sequenceFlow id="OV_f4" sourceRef="OV_s3" targetRef="OV_s4" />
    <bpmn:sequenceFlow id="OV_f5" sourceRef="OV_s4" targetRef="OV_s5" />
    <bpmn:sequenceFlow id="OV_f6" sourceRef="OV_s5" targetRef="OV_s6" />
  </bpmn:process>
  <bpmn:process id="OV_H_process" name="00 전체 흐름 / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>정상 완료 경로의 개요. 분기·반려·변경·공결·취소·성적 지연은 01–06 상세 파일에서 확인한다. 각 상자는 해당 상세 절차를 요약한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="OV_H_lanes">
      <bpmn:lane id="OV_H_lane0" name="학과·단과대학·학사팀·승인권자">
        <bpmn:flowNodeRef>OV_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_h1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_h2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_h4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_h5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_h6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OV_h0" name="신청 접수">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>OV_f7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OV_h0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="OV_h1" name="01 요건·전공 인정 심사&#10;학과장·대학장 확인">
      <bpmn:documentation>근거: W01 제4–6조; W02 3·4; S01</bpmn:documentation>
      <bpmn:incoming>OV_f7</bpmn:incoming>
      <bpmn:outgoing>OV_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_h2" name="01 총장 승인&#10;명단·추천 공문 송부">
      <bpmn:documentation>근거: W01 제6조; S03; S05; S04 P007–008</bpmn:documentation>
      <bpmn:incoming>OV_f8</bpmn:incoming>
      <bpmn:outgoing>OV_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_h4" name="06 공식 성적 수신&#10;인정·환산 검토">
      <bpmn:documentation>근거: W01 제13조; S04 P066–069
담당 판단·승인: G10. 세부 적용 기준은 해당 규정과 자료에서 확인한다.</bpmn:documentation>
      <bpmn:incoming>OV_f9</bpmn:incoming>
      <bpmn:outgoing>OV_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_h5" name="06 학점·성적 반영&#10;파견명단 J·K 작성">
      <bpmn:documentation>근거: W01 제13조; W03 제24조·제24조의2; S03 J1·K1</bpmn:documentation>
      <bpmn:incoming>OV_f10</bpmn:incoming>
      <bpmn:outgoing>OV_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="OV_h6" name="학사 결과 정리">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>OV_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="OV_f7" sourceRef="OV_h0" targetRef="OV_h1" />
    <bpmn:sequenceFlow id="OV_f8" sourceRef="OV_h1" targetRef="OV_h2" />
    <bpmn:sequenceFlow id="OV_f9" sourceRef="OV_h2" targetRef="OV_h4" />
    <bpmn:sequenceFlow id="OV_f10" sourceRef="OV_h4" targetRef="OV_h5" />
    <bpmn:sequenceFlow id="OV_f11" sourceRef="OV_h5" targetRef="OV_h6" />
  </bpmn:process>
  <bpmn:process id="OV_J_process" name="00 전체 흐름 / 교류대 · 제주대학교" isExecutable="false">
    <bpmn:documentation>정상 완료 경로의 개요. 분기·반려·변경·공결·취소·성적 지연은 01–06 상세 파일에서 확인한다. 각 상자는 해당 상세 절차를 요약한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="OV_J_lanes">
      <bpmn:lane id="OV_J_lane0" name="교육혁신과·수업 담당·수강료/시설 담당">
        <bpmn:flowNodeRef>OV_j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_j4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OV_j5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OV_j0" name="총장 추천 접수">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>OV_f12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OV_j0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="OV_j1" name="01 선발·학번 안내&#10;홈페이지 + 본교 공문">
      <bpmn:documentation>근거: S04 P002–013; S05 A24
담당 판단·승인: G05. 세부 적용 기준은 해당 규정과 자료에서 확인한다.</bpmn:documentation>
      <bpmn:incoming>OV_f12</bpmn:incoming>
      <bpmn:outgoing>OV_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_j2" name="02 수강신청·폐강 공고&#10;납부 확인·미납 삭제">
      <bpmn:documentation>근거: S04 P021–047</bpmn:documentation>
      <bpmn:incoming>OV_f13</bpmn:incoming>
      <bpmn:outgoing>OV_f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_j3" name="04 수업·출석·절대평가&#10;06 이의신청 처리">
      <bpmn:documentation>근거: S04 P048–069·P118–119</bpmn:documentation>
      <bpmn:incoming>OV_f14</bpmn:incoming>
      <bpmn:outgoing>OV_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OV_j4" name="06 백분위 실점수&#10;본교에 공식 송부">
      <bpmn:documentation>근거: S04 P066–069·P120–126</bpmn:documentation>
      <bpmn:incoming>OV_f15</bpmn:incoming>
      <bpmn:outgoing>OV_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="OV_j5" name="성적 송부">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>OV_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="OV_f12" sourceRef="OV_j0" targetRef="OV_j1" />
    <bpmn:sequenceFlow id="OV_f13" sourceRef="OV_j1" targetRef="OV_j2" />
    <bpmn:sequenceFlow id="OV_f14" sourceRef="OV_j2" targetRef="OV_j3" />
    <bpmn:sequenceFlow id="OV_f15" sourceRef="OV_j3" targetRef="OV_j4" />
    <bpmn:sequenceFlow id="OV_f16" sourceRef="OV_j4" targetRef="OV_j5" />
  </bpmn:process>
