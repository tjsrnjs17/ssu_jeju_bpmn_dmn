<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Level0_CreditExchange" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:process id="CreditExchange_Level0" name="숭실대 → 제주대 2026 여름계절제 학점교류 · As-Is Level 0" isExecutable="false">
    <bpmn:documentation>00-overview.bpmn의 기능 중심 상위 프로세스. 01~06 상세 BPMN은 각 서브프로세스의 문서에서 참조한다. 업무 단계 결과가 확인된 뒤 상위 분기를 적용한다. 확인 대기와 반영 보류는 현재 모델에서 확인된 진행 범위다.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="학점교류 신청 시작">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="SelectionPending" name="선발 결과 확인 대기">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NoSelection" name="미추천·미선발 확정">
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G01" name="선발 결과?" default="F05">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G02" name="등록·납부 상태?" default="F12">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G04" name="수학 결과?" default="F16">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G05" name="취소 결과?" default="F21">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G06" name="반영·기록 확정?" default="F24">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="학적·명단 처리 완료">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="RegistrationPending" name="등록·납부 결과 확인 대기">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="StudyPending" name="수학 상태 확인 대기">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CancellationPending" name="취소 결과 확인 대기">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="RecognitionPending" name="학점·명단 반영 보류">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="S01" name="01 신청·본교 승인&#10;제주대 선발">
      <bpmn:documentation>지원·추천·선발 결과를 확인한다. 선발과 학번이 확인된 경우 수강신청으로 진행한다.

상세 파일 · 01-application-and-selection.bpmn
학생 · AP_S_process
본교 · 숭실대학교 · AP_H_process
교류대 · 제주대학교 · AP_J_process</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="S02" name="02 수강신청·납부&#10;폐강 확인">
      <bpmn:documentation>승인 과목의 등록·납부·폐강 상태를 확인한다. 변경 결과가 들어오면 기존 상태에서 이어서 처리한다. 미수강 확정 건은 본교 후속 상태가 확인된 범위에서 명단 기록으로 넘긴다.

상세 파일 · 02-registration-payment.bpmn
학생 · RE_S_process
교류대 · 제주대학교 · RE_J_process</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="S03" name="03 수강변경&#10;재신청·재승인">
      <bpmn:documentation>변경 과목의 사전 재신청·승인과 수강신청 기간을 확인한다. 승인 또는 불승인 결과를 가지고 02를 재개한다.

상세 파일 · 03-course-change.bpmn
학생 · CH_S_process
본교 · 숭실대학교 · CH_H_process
교류대 · 제주대학교 · CH_J_process</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="S04" name="04 수업·시험&#10;출석·공결">
      <bpmn:documentation>유효한 등록 과목에 대해 수업·시험을 진행한다. 공결과 시설 이용은 발생한 경우 해당 상세 절차를 따른다.

상세 파일 · 04-study-attendance-facilities.bpmn
학생 · ST_S_process
본교 · 숭실대학교 · ST_H_process
교류대 · 제주대학교 · ST_J_process</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="S05" name="05 교류 취소&#10;수강료 환불">
      <bpmn:documentation>제주대 수강취소·환불과 숭실대 취소 요청 공문을 실제 결과로 확인한다. 전체 취소가 확정되면 명단을 정리하고, 유효 과목이 남으면 취소 요청이 들어온 단계에서 이어서 진행한다.

상세 파일 · 05-cancellation-refund.bpmn
학생 · CA_S_process
본교 · 숭실대학교 · CA_H_process
교류대 · 제주대학교 · CA_J_process</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="S06" name="06 성적·학점인정&#10;파견명단 정리">
      <bpmn:documentation>공식 성적을 수신한 건은 승인 내역과 대조해 학점인정 결과를 기록한다. 미수강·전체 취소가 확정된 건은 해당 결과를 파견명단 J/K에 기록한다.

상세 파일 · 06-grades-and-recognition.bpmn
학생 · GR_S_process
본교 · 숭실대학교 · GR_H_process
교류대 · 제주대학교 · GR_J_process</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
