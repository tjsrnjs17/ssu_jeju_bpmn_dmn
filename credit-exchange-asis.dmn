        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r10">
        <dmn:description>G06 | </dmn:description>
        <dmn:inputEntry id="D06_r10_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r10_o">
          <dmn:text>"제주대 고지서 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G06</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D07" name="07 수강료 납부 상태">
    <dmn:description>수강료 납부는 제주대에 직접 한다. 일반 등록금 납부나 숭실대 등록과 혼동하지 않는다.</dmn:description>
    <dmn:variable id="Var_D07" name="D07_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D07">
      <dmn:requiredInput href="#Input_D07" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D07" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D07_in1" label="기한 내 납부 확인">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D07_expr1" typeRef="string">
          <dmn:text>source_D07.payment</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D07_values1">
          <dmn:text>"PAID", "UNPAID", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D07_in2" label="확인 시각(KST)">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D07_expr2" typeRef="dateTime">
          <dmn:text>source_D07.checkedAt</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="D07_out" name="D07_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D07_r1">
        <dmn:description>S04 P040–044·P071–074 | </dmn:description>
        <dmn:inputEntry id="D07_r1_i1">
          <dmn:text>"PAID"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D07_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D07_r1_o">
          <dmn:text>"납부 확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P040–044·P071–074</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D07_r2">
        <dmn:description>S04 P043 | </dmn:description>
        <dmn:inputEntry id="D07_r2_i1">
          <dmn:text>"UNPAID"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D07_r2_i2">
          <dmn:text>&gt; date and time("2026-06-09T17:00:00+09:00")</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D07_r2_o">
          <dmn:text>"수강포기 간주·삭제"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P043</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D07_r3">
        <dmn:description>S04 P071–074 | 은행 창구는 해당 은행 마감시간을 확인.</dmn:description>
        <dmn:inputEntry id="D07_r3_i1">
          <dmn:text>"UNPAID"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D07_r3_i2">
          <dmn:text>[date and time("2026-06-04T10:00:00+09:00")..date and time("2026-06-09T17:00:00+09:00")]</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D07_r3_o">
          <dmn:text>"고지서에 따라 납부"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P071–074 — 은행 창구는 해당 은행 마감시간을 확인.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D07_r4">
        <dmn:description>S04 P071 | </dmn:description>
        <dmn:inputEntry id="D07_r4_i1">
          <dmn:text>"UNPAID"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D07_r4_i2">
          <dmn:text>&lt; date and time("2026-06-04T10:00:00+09:00")</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D07_r4_o">
          <dmn:text>"납부기간 확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P071</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D07_r5">
        <dmn:description>G06 | PAID는 기한 내 납부 사실이다. 미확정 상태에서 미납 삭제 판정을 내리지 않는다.</dmn:description>
        <dmn:inputEntry id="D07_r5_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D07_r5_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D07_r5_o">
          <dmn:text>"납부 상태 미확정"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G06 — PAID는 기한 내 납부 사실이다. 미확정 상태에서 미납 삭제 판정을 내리지 않는다.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D08" name="08 취소·환불 구간">
    <dmn:description>이 표는 비율 구간 판정이다. 실제 교류수학 취소에는 제주대 수강취소와 숭실대 취소 공문 두 절차가 필요하다(S04 P117).</dmn:description>
    <dmn:variable id="Var_D08" name="D08_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D08">
      <dmn:requiredInput href="#Input_D08" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D08" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D08_in1" label="환불 적용 상황">
        <dmn:description>STANDARD는 일반 일정 자발적 취소. 폐강·개별 일정은 담당자 확인.</dmn:description>
        <dmn:inputExpression id="D08_expr1" typeRef="string">
          <dmn:text>source_D08.refundScope</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D08_values1">
          <dmn:text>"STANDARD", "DIFFERENT_DATES", "CLOSURE", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D08_in2" label="사유일·신청일 구간 확인">
        <dmn:description>표는 사유발생일과 신청기간을 함께 제시. 구간이 다르면 G07로 보냄.</dmn:description>
        <dmn:inputExpression id="D08_expr2" typeRef="string">
          <dmn:text>source_D08.refundBasis</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D08_values2">
          <dmn:text>"SAME_PERIOD", "DIFFERENT_OR_UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D08_in3" label="취소/환불 신청 시각(KST)">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D08_expr3" typeRef="dateTime">
          <dmn:text>source_D08.requestedAt</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="D08_out" name="D08_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D08_r1">
        <dmn:description>S04 P114; G07 | </dmn:description>
        <dmn:inputEntry id="D08_r1_i1">
          <dmn:text>"DIFFERENT_DATES", "CLOSURE"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r1_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r1_o">
          <dmn:text>"담당자 개별 기준 확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P114; G07</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r2">
        <dmn:description>G07 | </dmn:description>
        <dmn:inputEntry id="D08_r2_i1">
          <dmn:text>"UNKNOWN", null</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r2_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r2_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r2_o">
          <dmn:text>"환불 자료 미확정"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G07</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r3">
        <dmn:description>S04 P100–114; G07 | </dmn:description>
        <dmn:inputEntry id="D08_r3_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r3_i2">
          <dmn:text>"DIFFERENT_OR_UNKNOWN", null</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r3_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r3_o">
          <dmn:text>"담당자 적용일 확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P100–114; G07</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r4">
        <dmn:description>S04 P103–105 | 6/28까지. 실제 지급 승인·지급일·원 단위 반올림은 별도.</dmn:description>
        <dmn:inputEntry id="D08_r4_i1">
          <dmn:text>"STANDARD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r4_i2">
          <dmn:text>"SAME_PERIOD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r4_i3">
          <dmn:text>&lt; date and time("2026-06-29T00:00:00+09:00")</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r4_o">
          <dmn:text>"전액 환불 구간"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P103–105 — 6/28까지. 실제 지급 승인·지급일·원 단위 반올림은 별도.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r5">
        <dmn:description>S04 P106–108 | </dmn:description>
        <dmn:inputEntry id="D08_r5_i1">
          <dmn:text>"STANDARD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r5_i2">
          <dmn:text>"SAME_PERIOD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r5_i3">
          <dmn:text>[date and time("2026-06-29T00:00:00+09:00")..date and time("2026-07-03T18:00:00+09:00")]</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r5_o">
          <dmn:text>"3분의 2 환불 구간"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P106–108</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r6">
        <dmn:description>S04 P109–111 | </dmn:description>
        <dmn:inputEntry id="D08_r6_i1">
          <dmn:text>"STANDARD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r6_i2">
          <dmn:text>"SAME_PERIOD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r6_i3">
          <dmn:text>(date and time("2026-07-03T18:00:00+09:00")..date and time("2026-07-07T18:00:00+09:00")]</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r6_o">
          <dmn:text>"2분의 1 환불 구간"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P109–111</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r7">
        <dmn:description>S04 P112–113 | </dmn:description>
        <dmn:inputEntry id="D08_r7_i1">
          <dmn:text>"STANDARD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r7_i2">
          <dmn:text>"SAME_PERIOD"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r7_i3">
          <dmn:text>&gt; date and time("2026-07-07T18:00:00+09:00")</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r7_o">
          <dmn:text>"수강취소·환불 불가"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P112–113</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D08_r8">
        <dmn:description>G07 | </dmn:description>
        <dmn:inputEntry id="D08_r8_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r8_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D08_r8_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D08_r8_o">
          <dmn:text>"환불 자료 미확정"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G07</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D09" name="09 출석 요건">
    <dmn:description>공결 승인 여부는 교육혁신과/승인권자가 확인한다. S04는 7일 이내 신청을 명시하며 W04 일반 안내에는 토요일·공휴일 제외, 증빙, 승인 경로 및 일부 예외가 있다. 교류생의 적용을 G08에서 확인. 이 표는 S04 기본 출석요건을 표현하며 별도 규정 예외는 담당확인으로 보낸다.</dmn:description>
    <dmn:variable id="Var_D09" name="D09_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D09">
      <dmn:requiredInput href="#Input_D09" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D09" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D09_in1" label="해당 강좌 전체 출석 시수">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D09_expr1" typeRef="number">
          <dmn:text>source_D09.totalHours</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D09_in2" label="실제 출석 시수">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D09_expr2" typeRef="number">
          <dmn:text>source_D09.attendedHours</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D09_in3" label="승인된 출석인정 시수">
        <dmn:description>담당자 승인 후 값만 입력. 단순 공결 신청 시수가 아님.</dmn:description>
        <dmn:inputExpression id="D09_expr3" typeRef="number">
          <dmn:text>source_D09.excusedHours</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="D09_out" name="D09_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D09_r1">
        <dmn:description>G08 | </dmn:description>
        <dmn:inputEntry id="D09_r1_i1">
          <dmn:text>null, &lt;= 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r1_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r1_o">
          <dmn:text>"출석 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G08</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r2">
        <dmn:description>G08 | </dmn:description>
        <dmn:inputEntry id="D09_r2_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r2_i2">
          <dmn:text>null, &lt; 0, &gt; source_D09.totalHours</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r2_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r2_o">
          <dmn:text>"출석 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G08</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r3">
        <dmn:description>S04 P051; G08 | 1/4 초과 입력은 임의 절삭하지 않음.</dmn:description>
        <dmn:inputEntry id="D09_r3_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r3_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r3_i3">
          <dmn:text>null, &lt; 0, &gt; source_D09.totalHours / 4</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r3_o">
          <dmn:text>"출석 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P051; G08 — 1/4 초과 입력은 임의 절삭하지 않음.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r4">
        <dmn:description>G08 | 실제 출석과 인정 시수의 이중계상 확인.</dmn:description>
        <dmn:inputEntry id="D09_r4_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r4_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r4_i3">
          <dmn:text>&gt; source_D09.totalHours - source_D09.attendedHours</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r4_o">
          <dmn:text>"출석 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G08 — 실제 출석과 인정 시수의 이중계상 확인.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r5">
        <dmn:description>S04 P051 | </dmn:description>
        <dmn:inputEntry id="D09_r5_i1">
          <dmn:text>&gt; 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r5_i2">
          <dmn:text>&gt;= source_D09.totalHours * 3 / 4 - source_D09.excusedHours</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r5_i3">
          <dmn:text>[0..source_D09.totalHours / 4]</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r5_o">
          <dmn:text>"출석 요건 충족·성적평가 별도"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P051</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r6">
        <dmn:description>S04 P051 | 자동 F 부여나 모든 성적조건 충족으로 확대하지 않음.</dmn:description>
        <dmn:inputEntry id="D09_r6_i1">
          <dmn:text>&gt; 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r6_i2">
          <dmn:text>&lt; source_D09.totalHours * 3 / 4 - source_D09.excusedHours</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r6_i3">
          <dmn:text>[0..source_D09.totalHours / 4]</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r6_o">
          <dmn:text>"학점인정 출석 요건 미충족"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P051 — 자동 F 부여나 모든 성적조건 충족으로 확대하지 않음.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D09_r7">
        <dmn:description>G08 | </dmn:description>
        <dmn:inputEntry id="D09_r7_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r7_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D09_r7_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D09_r7_o">
          <dmn:text>"출석 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G08</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D10" name="10 학점·성적 반영 경로">
    <dmn:description>공식 성적과 승인·이수구분 기록을 사용한다. 성적 수신 후 별도 학과 재심사 유무는 I30에서 확인한다. 실제 적용 환산 기준과 변경 과목 인정 여부가 확인되어야 반영한다.</dmn:description>
    <dmn:variable id="Var_D10" name="D10_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D10">
      <dmn:requiredInput href="#Input_D10" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D10" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D10_in1" label="제주대 공식 성적 수신">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D10_expr1" typeRef="string">
          <dmn:text>source_D10.officialGrades</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D10_values1">
          <dmn:text>"RECEIVED", "WAITING", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D10_in2" label="해당 과목의 본교 승인">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D10_expr2" typeRef="string">
          <dmn:text>source_D10.recognitionApproval</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D10_values2">
          <dmn:text>"APPROVED_ORIGINAL", "APPROVED_CHANGE", "NOT_APPROVED", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D10_in3" label="실제 인정 학점 한도">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D10_expr3" typeRef="string">
          <dmn:text>source_D10.creditCheck</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D10_values3">
          <dmn:text>"WITHIN", "OVER", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D10_in4" label="확정된 인정 이수구분">
        <dmn:description>사전 승인 기록 또는 실제 인정 결과에서 확인한다. 변경 과목의 인정 적용이나 이수구분이 미확정이면 UNDECIDED를 입력한다.</dmn:description>
        <dmn:inputExpression id="D10_expr4" typeRef="string">
          <dmn:text>source_D10.deptCategory</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D10_values4">
          <dmn:text>"MAJOR_ELECTIVE", "GENERAL_ELECTIVE", "NOT_RECOGNIZED", "UNDECIDED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D10_in5" label="성적 환산·학적 조건 확인">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D10_expr5" typeRef="string">
          <dmn:text>source_D10.conversion</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D10_values5">
          <dmn:text>"CONFIRMED", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="D10_out" name="D10_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D10_r1">
        <dmn:description>S04 P066–069·P120–126 | </dmn:description>
        <dmn:inputEntry id="D10_r1_i1">
          <dmn:text>"WAITING"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D10_r1_i2">
