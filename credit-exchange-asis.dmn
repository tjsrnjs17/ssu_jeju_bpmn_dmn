        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r10">
        <dmn:description>W01 제4조; W02 3.나 | 최종 승인·선발을 뜻하지 않음.</dmn:description>
        <dmn:inputEntry id="D01_r10_i1">
          <dmn:text>"GENERAL"</dmn:text>
