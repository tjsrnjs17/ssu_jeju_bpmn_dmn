  <dmn:decision id="D04" name="04 신청 자료 준비">
    <dmn:description>숭실대 학과 제출 후 LMS 신청 순서를 따른다. 학과장 서명은 직접 판단·서명 작업이다.</dmn:description>
    <dmn:variable id="Var_D04" name="D04_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D04">
      <dmn:requiredInput href="#Input_D04" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D04" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D04_in1" label="신청서 개인정보 동의">
