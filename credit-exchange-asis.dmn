  <dmn:decision id="D05" name="05 변경 과목 처리">
    <dmn:description>수강신청 가능 경로를 판정한다. 변경 과목의 최종 인정과 S01 C30의 적용 범위는 I15에서 확인하며 D10에는 확정된 인정 정보를 입력한다.</dmn:description>
    <dmn:variable id="Var_D05" name="D05_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D05">
      <dmn:requiredInput href="#Input_D05" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D05" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D05_in1" label="기승인 신청서와 실제 과목">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D05_expr1" typeRef="string">
          <dmn:text>source_D05.courseMatches</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D05_values1">
          <dmn:text>"MATCH", "DIFFERENT", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D05_in2" label="변경 전 재신청·승인">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D05_expr2" typeRef="string">
          <dmn:text>source_D05.priorApproval</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D05_values2">
          <dmn:text>"APPROVED", "NOT_YET", "DENIED", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D05_in3" label="제주대 신청기간">
        <dmn:description>CLOSED는 해당 신청기간 종료 상태다.</dmn:description>
        <dmn:inputExpression id="D05_expr3" typeRef="string">
          <dmn:text>source_D05.registrationWindow</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D05_values3">
          <dmn:text>"OPEN", "NOT_STARTED", "CLOSED", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="D05_out" name="D05_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D05_r1">
        <dmn:description>S04 P039; G05 | </dmn:description>
        <dmn:inputEntry id="D05_r1_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r1_i3">
