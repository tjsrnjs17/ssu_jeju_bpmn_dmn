        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r7_o">
          <dmn:text>"시수당 100000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행7</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r8">
