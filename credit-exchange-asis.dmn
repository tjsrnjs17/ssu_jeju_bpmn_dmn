        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D06" name="06 수강료 단가">
    <dmn:description>HWP 표의 열 위치를 확인하여 학점당/시수당을 구분했다. 강좌 분류·과금 시수·합계·원 단위 처리는 임의 계산하지 않고 공식 고지서를 따른다.</dmn:description>
    <dmn:variable id="Var_D06" name="D06_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D06">
      <dmn:requiredInput href="#Input_D06" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D06" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D06_in1" label="제주대 확인 강좌 구분">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D06_expr1" typeRef="string">
          <dmn:text>source_D06.feeCategory</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D06_values1">
          <dmn:text>"GENERAL", "LAB", "CLINICAL", "ART_SPORT", "PRINT", "OLLE", "PADDLE", "YACHT", "SCUBA", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="D06_out" name="D06_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D06_r1">
        <dmn:description>S04 P075–096 / 수강료 표 행1 | </dmn:description>
        <dmn:inputEntry id="D06_r1_i1">
          <dmn:text>"GENERAL"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r1_o">
          <dmn:text>"학점당 28000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P075–096 / 수강료 표 행1</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r2">
        <dmn:description>S04 수강료 표 행2 | </dmn:description>
        <dmn:inputEntry id="D06_r2_i1">
          <dmn:text>"LAB"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r2_o">
          <dmn:text>"학점당 30000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행2</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r3">
        <dmn:description>S04 수강료 표 행3 | </dmn:description>
        <dmn:inputEntry id="D06_r3_i1">
          <dmn:text>"CLINICAL"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r3_o">
          <dmn:text>"학점당 50000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행3</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r4">
        <dmn:description>S04 수강료 표 행4·P097 | </dmn:description>
        <dmn:inputEntry id="D06_r4_i1">
          <dmn:text>"ART_SPORT"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r4_o">
          <dmn:text>"시수당 50000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행4·P097</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r5">
        <dmn:description>S04 수강료 표 행5 | </dmn:description>
        <dmn:inputEntry id="D06_r5_i1">
          <dmn:text>"PRINT"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r5_o">
          <dmn:text>"시수당 60000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행5</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r6">
        <dmn:description>S04 수강료 표 행6 | </dmn:description>
        <dmn:inputEntry id="D06_r6_i1">
          <dmn:text>"OLLE"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r6_o">
          <dmn:text>"시수당 200000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행6</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r7">
        <dmn:description>S04 수강료 표 행7 | </dmn:description>
        <dmn:inputEntry id="D06_r7_i1">
