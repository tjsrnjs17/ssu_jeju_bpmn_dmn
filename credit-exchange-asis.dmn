        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r7_i2">
          <dmn:text>"APPROVED"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r7_i3">
          <dmn:text>"NOT_STARTED"</dmn:text>
        </dmn:inputEntry>
