        <dmn:inputEntry id="D06_r8_i1">
          <dmn:text>"YACHT"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r8_o">
          <dmn:text>"시수당 150000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 수강료 표 행8</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D06_r9">
        <dmn:description>S04 수강료 표 행9 | </dmn:description>
        <dmn:inputEntry id="D06_r9_i1">
          <dmn:text>"SCUBA"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D06_r9_o">
          <dmn:text>"시수당 250000원"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
