        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P039; G05</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r2">
        <dmn:description>W01 제11조제1항; S04 P023–039 | </dmn:description>
        <dmn:inputEntry id="D05_r2_i1">
          <dmn:text>"MATCH"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r2_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r2_i3">
          <dmn:text>"OPEN"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D05_r2_o">
          <dmn:text>"승인 과목 신청 진행"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제11조제1항; S04 P023–039</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r3">
        <dmn:description>W01 제5·6·11조; W02 4.나.4 | </dmn:description>
        <dmn:inputEntry id="D05_r3_i1">
          <dmn:text>"DIFFERENT"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r3_i2">
          <dmn:text>"NOT_YET"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r3_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D05_r3_o">
          <dmn:text>"수강신청 전 재승인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제5·6·11조; W02 4.나.4</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r4">
        <dmn:description>W01 제11조 | </dmn:description>
        <dmn:inputEntry id="D05_r4_i1">
          <dmn:text>"DIFFERENT"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r4_i2">
          <dmn:text>"DENIED"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r4_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D05_r4_o">
          <dmn:text>"변경 과목 신청 중지"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제11조</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r5">
        <dmn:description>W01 제11조 | </dmn:description>
        <dmn:inputEntry id="D05_r5_i1">
          <dmn:text>"DIFFERENT"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r5_i2">
          <dmn:text>"APPROVED"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r5_i3">
          <dmn:text>"OPEN"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D05_r5_o">
          <dmn:text>"재승인 과목 신청 진행"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제11조</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r6">
        <dmn:description>S04 P023–039 | </dmn:description>
        <dmn:inputEntry id="D05_r6_i1">
          <dmn:text>"MATCH"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r6_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D05_r6_i3">
          <dmn:text>"NOT_STARTED"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D05_r6_o">
          <dmn:text>"수강신청 기간 대기"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P023–039</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D05_r7">
