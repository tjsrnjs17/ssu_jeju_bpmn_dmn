  </dmn:decision>
  <dmn:decision id="D02" name="02 학점 범위">
    <dmn:description>최종 인정에서는 인정 예정값을 실제 인정 대상 학점으로 바꾸어 확인한다. 1/3의 임의 올림·내림은 하지 않는다.</dmn:description>
    <dmn:variable id="Var_D02" name="D02_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D02">
      <dmn:requiredInput href="#Input_D02" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D02" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D02_in1" label="제주대 신청 학점">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D02_expr1" typeRef="number">
          <dmn:text>source_D02.exchangeCredits</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D02_in2" label="이번 계절제 총 신청 학점">
        <dmn:description>숭실대+제주대+기타 교류 대학의 같은 여름계절제. 정규 1학기 학점은 합산하지 않음.</dmn:description>
        <dmn:inputExpression id="D02_expr2" typeRef="number">
          <dmn:text>source_D02.summerCredits</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D02_in3" label="기취득 교류+이번 인정예정">
        <dmn:description>이번 신청 과목을 모두 인정하는 경우의 계획상 누계. 실제 인정 단계는 실제 취득학점으로 재검사.</dmn:description>
        <dmn:inputExpression id="D02_expr3" typeRef="number">
          <dmn:text>source_D02.prospectiveCredits</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D02_in4" label="해당 학생 졸업요구 학점">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D02_expr4" typeRef="number">
          <dmn:text>source_D02.graduationCredits</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D02_in5" label="계절제 합산·학적 자료 확인">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D02_expr5" typeRef="string">
          <dmn:text>source_D02.creditFacts</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D02_values5">
          <dmn:text>"CONFIRMED", "UNCONFIRMED"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="D02_out" name="D02_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D02_r1">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r1_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r1_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r1_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r1_i5">
          <dmn:text>"UNCONFIRMED", null</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r1_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r2">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r2_i1">
          <dmn:text>null, &lt;= 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r2_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r2_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r2_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r2_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r2_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r3">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r3_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r3_i2">
          <dmn:text>null, &lt; source_D02.exchangeCredits</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r3_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r3_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r3_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r3_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r4">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r4_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r4_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r4_i3">
          <dmn:text>null, &lt; source_D02.exchangeCredits</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r4_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r4_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r4_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r5">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r5_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r5_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r5_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r5_i4">
          <dmn:text>null, &lt;= 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r5_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r5_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r6">
        <dmn:description>S04 P028; W02 3.가 | </dmn:description>
        <dmn:inputEntry id="D02_r6_i1">
          <dmn:text>&gt; 6</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r6_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r6_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r6_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r6_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r6_o">
          <dmn:text>"신청 학점 조정"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P028; W02 3.가</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r7">
        <dmn:description>W02 4.나.1; W03 제49조제4항; G02 | 원칙 6학점. 예외 허용을 자동 생성하지 않음.</dmn:description>
        <dmn:inputEntry id="D02_r7_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r7_i2">
          <dmn:text>&gt; 6</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r7_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r7_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r7_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r7_o">
          <dmn:text>"계절제 한도 담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W02 4.나.1; W03 제49조제4항; G02 — 원칙 6학점. 예외 허용을 자동 생성하지 않음.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r8">
        <dmn:description>W01 제10조제1항; W02 4.가.1 | 취득 한도이며 지원자 전체 자동 탈락 규칙이 아님.</dmn:description>
        <dmn:inputEntry id="D02_r8_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r8_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r8_i3">
          <dmn:text>&gt; source_D02.graduationCredits / 3</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r8_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r8_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r8_o">
          <dmn:text>"인정 범위 계획 조정"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제10조제1항; W02 4.가.1 — 취득 한도이며 지원자 전체 자동 탈락 규칙이 아님.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r9">
        <dmn:description>S04 P028; W01 제10조; W02 3.가·4.나; W03 제49조 | </dmn:description>
        <dmn:inputEntry id="D02_r9_i1">
          <dmn:text>(0..6]</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r9_i2">
          <dmn:text>[source_D02.exchangeCredits..6]</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r9_i3">
          <dmn:text>[source_D02.exchangeCredits..source_D02.graduationCredits / 3]</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r9_i4">
          <dmn:text>&gt; 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r9_i5">
          <dmn:text>"CONFIRMED"</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r9_o">
          <dmn:text>"학점 범위 충족"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>S04 P028; W01 제10조; W02 3.가·4.나; W03 제49조</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D02_r10">
        <dmn:description>G02 | </dmn:description>
        <dmn:inputEntry id="D02_r10_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r10_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r10_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r10_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D02_r10_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D02_r10_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G02</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="D03" name="03 과목 이수 제한">
    <dmn:description>매 과목 단위로 판정한다. 과목명이나 유사도 점수로 동일성·전공 인정을 자동 분류하지 않는다.</dmn:description>
    <dmn:variable id="Var_D03" name="D03_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D03">
      <dmn:requiredInput href="#Input_D03" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D03" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D03_in1" label="본교 필수·다전공 제한">
        <dmn:description>교양필수·전공기초·전공필수 및 예외 아닌 다전공은 BLOCKED. 학과가 과목 분류와 예외 해당 여부 확인.</dmn:description>
        <dmn:inputExpression id="D03_expr1" typeRef="string">
          <dmn:text>source_D03.ssuRestriction</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D03_values1">
          <dmn:text>"BLOCKED", "CLEAR", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D03_in2" label="본교 기이수 동일 과목">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D03_expr2" typeRef="string">
          <dmn:text>source_D03.sameCompleted</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D03_values2">
          <dmn:text>"YES", "NO", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D03_in3" label="제주대 수강 제한">
        <dmn:description>학과제한·OCU·KNU·특허청·진로/취업/창업상담·사회봉사·현장실습은 BLOCKED.</dmn:description>
        <dmn:inputExpression id="D03_expr3" typeRef="string">
          <dmn:text>source_D03.jejuRestriction</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D03_values3">
          <dmn:text>"BLOCKED", "CLEAR", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D03_in4" label="재수강 장소 조건">
