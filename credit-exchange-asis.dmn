<?xml version='1.0' encoding='utf-8'?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dmndiway="http://www.omg.org/spec/DMN/20180521/DI/" id="Definitions_CreditExchange" name="숭실대→제주대 2026 여름 As-Is 의사결정" namespace="https://example.org/ssu-jeju/2026/decisions" exporter="Document-grounded DMN" exporterVersion="1.0">
  <dmn:description>문서에 명시된 기준의 정형화. 실제 학교가 DMN을 운영한다고 주장하지 않으며 담당자의 판단을 대체하지 않는다. 빈 입력은 null, 분류 미확인은 UNKNOWN/UNCONFIRMED 등 표별 값을 사용한다. 일반 파견 기준이다.</dmn:description>
  <dmn:inputData id="Input_D01" name="01 지원 자격 확인 자료">
    <dmn:description>입력 계약: [{"key": "track", "label": "교류 유형", "type": "string", "domain": ["GENERAL", "OTHER", "UNKNOWN"], "note": "GENERAL=일반 학부 교류. 차세대반도체 등 별도 트랙은 OTHER."}, {"key": "studentState", "label": "숭실대 재학 학부생", "type": "string", "domain": ["YES", "NO", "UNKNOWN"], "note": ""}, {"key": "semester", "label": "2026-1 재학 학기", "type": "number", "domain": null, "note": "학년이 아닌 재학 학기. 정수 여부는 입력 계약에서 확인."}, {"key": "gpa", "label": "직전 학기까지 총 평점", "type": "number", "domain": null, "note": "공식 학적부 총 평점평균. 직전 학기 단독 GPA가 아님."}, {"key": "discipline", "label": "징계 사실", "type": "string", "domain": ["NONE", "EXISTS", "UNKNOWN"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D01" name="source_D01" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D02" name="02 학점 범위 확인 자료">
    <dmn:description>입력 계약: [{"key": "exchangeCredits", "label": "제주대 신청 학점", "type": "number", "domain": null, "note": ""}, {"key": "summerCredits", "label": "이번 계절제 총 신청 학점", "type": "number", "domain": null, "note": "숭실대+제주대+기타 교류 대학의 같은 여름계절제. 정규 1학기 학점은 합산하지 않음."}, {"key": "prospectiveCredits", "label": "기취득 교류+이번 인정예정", "type": "number", "domain": null, "note": "이번 신청 과목을 모두 인정하는 경우의 계획상 누계. 실제 인정 단계는 실제 취득학점으로 재검사."}, {"key": "graduationCredits", "label": "해당 학생 졸업요구 학점", "type": "number", "domain": null, "note": ""}, {"key": "creditFacts", "label": "계절제 합산·학적 자료 확인", "type": "string", "domain": ["CONFIRMED", "UNCONFIRMED"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D02" name="source_D02" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D03" name="03 과목 이수 제한 확인 자료">
    <dmn:description>입력 계약: [{"key": "ssuRestriction", "label": "본교 필수·다전공 제한", "type": "string", "domain": ["BLOCKED", "CLEAR", "UNKNOWN"], "note": "교양필수·전공기초·전공필수 및 예외 아닌 다전공은 BLOCKED. 학과가 과목 분류와 예외 해당 여부 확인."}, {"key": "sameCompleted", "label": "본교 기이수 동일 과목", "type": "string", "domain": ["YES", "NO", "UNKNOWN"], "note": ""}, {"key": "jejuRestriction", "label": "제주대 수강 제한", "type": "string", "domain": ["BLOCKED", "CLEAR", "UNKNOWN"], "note": "학과제한·OCU·KNU·특허청·진로/취업/창업상담·사회봉사·현장실습은 BLOCKED."}, {"key": "retakePlace", "label": "재수강 장소 조건", "type": "string", "domain": ["SAME_HOST", "NOT_RETAKE", "OTHER_HOST", "UNKNOWN"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D03" name="source_D03" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D04" name="04 신청 자료 준비 확인 자료">
    <dmn:description>입력 계약: [{"key": "consent", "label": "신청서 개인정보 동의", "type": "string", "domain": ["YES", "NO", "UNKNOWN"], "note": ""}, {"key": "deptSubmission", "label": "학과 제출", "type": "string", "domain": ["DONE", "MISSING", "UNKNOWN"], "note": ""}, {"key": "xlsxFile", "label": "신청서 엑셀 원본", "type": "string", "domain": ["PRESENT", "MISSING", "UNKNOWN"], "note": ""}, {"key": "signedScan", "label": "학과장 서명 스캔", "type": "string", "domain": ["PRESENT", "MISSING", "UNKNOWN"], "note": ""}, {"key": "lmsSubmission", "label": "LMS 신청", "type": "string", "domain": ["DONE", "MISSING", "UNKNOWN"], "note": ""}, {"key": "otherRequired", "label": "해당 공지 추가서류", "type": "string", "domain": ["COMPLETE", "MISSING", "UNKNOWN"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D04" name="source_D04" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D05" name="05 변경 과목 처리 확인 자료">
    <dmn:description>입력 계약: [{"key": "courseMatches", "label": "기승인 신청서와 실제 과목", "type": "string", "domain": ["MATCH", "DIFFERENT", "UNKNOWN"], "note": ""}, {"key": "priorApproval", "label": "변경 전 재신청·승인", "type": "string", "domain": ["APPROVED", "NOT_YET", "DENIED", "UNKNOWN"], "note": ""}, {"key": "registrationWindow", "label": "제주대 신청기간", "type": "string", "domain": ["OPEN", "NOT_STARTED", "CLOSED", "UNKNOWN"], "note": "CLOSED는 해당 신청기간 종료 상태다."}]</dmn:description>
    <dmn:variable id="Var_Input_D05" name="source_D05" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D06" name="06 수강료 단가 확인 자료">
    <dmn:description>입력 계약: [{"key": "feeCategory", "label": "제주대 확인 강좌 구분", "type": "string", "domain": ["GENERAL", "LAB", "CLINICAL", "ART_SPORT", "PRINT", "OLLE", "PADDLE", "YACHT", "SCUBA", "UNKNOWN"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D06" name="source_D06" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D07" name="07 수강료 납부 상태 확인 자료">
    <dmn:description>입력 계약: [{"key": "payment", "label": "기한 내 납부 확인", "type": "string", "domain": ["PAID", "UNPAID", "UNCONFIRMED"], "note": ""}, {"key": "checkedAt", "label": "확인 시각(KST)", "type": "dateTime", "domain": null, "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D07" name="source_D07" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D08" name="08 취소·환불 구간 확인 자료">
    <dmn:description>입력 계약: [{"key": "refundScope", "label": "환불 적용 상황", "type": "string", "domain": ["STANDARD", "DIFFERENT_DATES", "CLOSURE", "UNKNOWN"], "note": "STANDARD는 일반 일정 자발적 취소. 폐강·개별 일정은 담당자 확인."}, {"key": "refundBasis", "label": "사유일·신청일 구간 확인", "type": "string", "domain": ["SAME_PERIOD", "DIFFERENT_OR_UNKNOWN"], "note": "표는 사유발생일과 신청기간을 함께 제시. 구간이 다르면 G07로 보냄."}, {"key": "requestedAt", "label": "취소/환불 신청 시각(KST)", "type": "dateTime", "domain": null, "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D08" name="source_D08" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D09" name="09 출석 요건 확인 자료">
    <dmn:description>입력 계약: [{"key": "totalHours", "label": "해당 강좌 전체 출석 시수", "type": "number", "domain": null, "note": ""}, {"key": "attendedHours", "label": "실제 출석 시수", "type": "number", "domain": null, "note": ""}, {"key": "excusedHours", "label": "승인된 출석인정 시수", "type": "number", "domain": null, "note": "담당자 승인 후 값만 입력. 단순 공결 신청 시수가 아님."}]</dmn:description>
    <dmn:variable id="Var_Input_D09" name="source_D09" typeRef="Any" />
  </dmn:inputData>
  <dmn:inputData id="Input_D10" name="10 학점·성적 반영 경로 확인 자료">
    <dmn:description>입력 계약: [{"key": "officialGrades", "label": "제주대 공식 성적 수신", "type": "string", "domain": ["RECEIVED", "WAITING", "UNCONFIRMED"], "note": ""}, {"key": "recognitionApproval", "label": "해당 과목의 본교 승인", "type": "string", "domain": ["APPROVED_ORIGINAL", "APPROVED_CHANGE", "NOT_APPROVED", "UNCONFIRMED"], "note": ""}, {"key": "creditCheck", "label": "실제 인정 학점 한도", "type": "string", "domain": ["WITHIN", "OVER", "UNCONFIRMED"], "note": ""}, {"key": "deptCategory", "label": "확정된 인정 이수구분", "type": "string", "domain": ["MAJOR_ELECTIVE", "GENERAL_ELECTIVE", "NOT_RECOGNIZED", "UNDECIDED"], "note": "사전 승인 기록 또는 실제 인정 결과에서 확인한다. 변경 과목의 인정 적용이나 이수구분이 미확정이면 UNDECIDED를 입력한다."}, {"key": "conversion", "label": "성적 환산·학적 조건 확인", "type": "string", "domain": ["CONFIRMED", "UNCONFIRMED"], "note": ""}]</dmn:description>
    <dmn:variable id="Var_Input_D10" name="source_D10" typeRef="Any" />
  </dmn:inputData>
  <dmn:decision id="D01" name="01 지원 자격">
    <dmn:description>일반 파견 자격의 정형 조건이다. 신청 횟수 제한은 만들지 않는다(W01 제8조).</dmn:description>
    <dmn:variable id="Var_D01" name="D01_result" typeRef="string" />
    <dmn:informationRequirement id="Req_D01">
      <dmn:requiredInput href="#Input_D01" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="Table_D01" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <dmn:input id="D01_in1" label="교류 유형">
        <dmn:description>GENERAL=일반 학부 교류. 차세대반도체 등 별도 트랙은 OTHER.</dmn:description>
        <dmn:inputExpression id="D01_expr1" typeRef="string">
          <dmn:text>source_D01.track</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D01_values1">
          <dmn:text>"GENERAL", "OTHER", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D01_in2" label="숭실대 재학 학부생">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D01_expr2" typeRef="string">
          <dmn:text>source_D01.studentState</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D01_values2">
          <dmn:text>"YES", "NO", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="D01_in3" label="2026-1 재학 학기">
        <dmn:description>학년이 아닌 재학 학기. 정수 여부는 입력 계약에서 확인.</dmn:description>
        <dmn:inputExpression id="D01_expr3" typeRef="number">
          <dmn:text>source_D01.semester</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D01_in4" label="직전 학기까지 총 평점">
        <dmn:description>공식 학적부 총 평점평균. 직전 학기 단독 GPA가 아님.</dmn:description>
        <dmn:inputExpression id="D01_expr4" typeRef="number">
          <dmn:text>source_D01.gpa</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="D01_in5" label="징계 사실">
        <dmn:description>확인된 원자료를 입력하며 추정값을 넣지 않는다.</dmn:description>
        <dmn:inputExpression id="D01_expr5" typeRef="string">
          <dmn:text>source_D01.discipline</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues id="D01_values5">
          <dmn:text>"NONE", "EXISTS", "UNKNOWN"</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="D01_out" name="D01_result" label="판정 / 다음 처리" typeRef="string" />
      <dmn:annotation name="근거·해석 범위" />
      <dmn:rule id="D01_r1">
        <dmn:description>G09; W01 제36조 | 별도 트랙에 일반 기준을 확장하지 않음.</dmn:description>
        <dmn:inputEntry id="D01_r1_i1">
          <dmn:text>"OTHER", "UNKNOWN"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r1_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r1_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r1_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r1_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r1_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G09; W01 제36조 — 별도 트랙에 일반 기준을 확장하지 않음.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r2">
        <dmn:description>G01 | </dmn:description>
        <dmn:inputEntry id="D01_r2_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r2_i2">
          <dmn:text>"UNKNOWN", null</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r2_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r2_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r2_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r2_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G01</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r3">
        <dmn:description>G01 | </dmn:description>
        <dmn:inputEntry id="D01_r3_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r3_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r3_i3">
          <dmn:text>null, &lt; 1</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r3_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r3_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r3_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G01</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r4">
        <dmn:description>G01 | </dmn:description>
        <dmn:inputEntry id="D01_r4_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r4_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r4_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r4_i4">
          <dmn:text>null, &lt; 0</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r4_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r4_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G01</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r5">
        <dmn:description>G01 | </dmn:description>
        <dmn:inputEntry id="D01_r5_i1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r5_i2">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r5_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r5_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r5_i5">
          <dmn:text>"UNKNOWN", null</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r5_o">
          <dmn:text>"담당확인"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>G01</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r6">
        <dmn:description>W01 제4조; W02 3.나 | </dmn:description>
        <dmn:inputEntry id="D01_r6_i1">
          <dmn:text>"GENERAL"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r6_i2">
          <dmn:text>"NO"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r6_i3">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r6_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r6_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r6_o">
          <dmn:text>"자격 미충족"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제4조; W02 3.나</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="D01_r7">
        <dmn:description>W01 제4조; W02 3.나 | </dmn:description>
        <dmn:inputEntry id="D01_r7_i1">
          <dmn:text>"GENERAL"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r7_i2">
          <dmn:text>"YES"</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r7_i3">
          <dmn:text>&lt; 3, &gt; 7</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r7_i4">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="D01_r7_i5">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="D01_r7_o">
          <dmn:text>"자격 미충족"</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>W01 제4조; W02 3.나</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
