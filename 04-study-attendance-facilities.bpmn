<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_ST" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="ST_Collaboration" name="04 수업·시험·공결·시설">
    <bpmn:documentation>As-Is 규정 모델. 04 수업·시험·공결·시설
수업 기간 중 발생하는 공결과 취소 신청을 처리한다. 시설 이용과 일반 추가시험 안내는 수업 절차에 참고한다.
주황색은 담당자의 승인 또는 판단 단계. I번호 주석은 인터뷰 확인 사항. 참고 BPMN은 근거에서 제외.</bpmn:documentation>
    <bpmn:participant id="ST_S" name="학생" processRef="ST_S_process" />
    <bpmn:participant id="ST_H" name="본교 · 숭실대학교" processRef="ST_H_process" />
    <bpmn:participant id="ST_J" name="교류대 · 제주대학교" processRef="ST_J_process" />
    <bpmn:messageFlow id="ST_m1" name="수업 참여" sourceRef="ST_s3" targetRef="ST_j0" />
    <bpmn:messageFlow id="ST_m2" name="강의·출결 문의" sourceRef="ST_s7" targetRef="ST_j1" />
    <bpmn:messageFlow id="ST_m3" name="공결 신청·증빙" sourceRef="ST_s5" targetRef="ST_j5" />
    <bpmn:messageFlow id="ST_m4" name="공결 결정" sourceRef="ST_j6" targetRef="ST_s6" />
  </bpmn:collaboration>
  <bpmn:process id="ST_S_process" name="04 수업·시험·공결·시설 / 학생" isExecutable="false">
    <bpmn:documentation>수업 기간 중 발생하는 공결과 취소 신청을 처리한다. 시설 이용과 일반 추가시험 안내는 수업 절차에 참고한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="ST_S_lanes">
      <bpmn:lane id="ST_S_lane0" name="수학 중 학생">
        <bpmn:flowNodeRef>ST_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_s14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ST_s0" name="유효 등록·납부 완료">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>ST_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ST_s2" name="수업·시험 일정과&#10;응시 방식 확인">
      <bpmn:documentation>근거: S04 P048–061·P122–125; W02 4.나.3; W04 시험
6/29–7/20 수업. JNUclass. 중간 7/8·기말 7/20, 과목별 상이. 원격 기말 7/17–20 예정. 일반 추가시험 안내에는 시험기간 개시 3일 전 신청·증빙·학장 승인, B+(3.3) 이하 원칙 및 시험시간 중복·출석인정 예외가 있다. 해당 교류 과목의 적용 여부는 관련 규정을 확인한다. 시설 이용 희망 시 모바일 학생증, 차량 등록, 학생생활관 안내를 이용한다.</bpmn:documentation>
      <bpmn:incoming>ST_f1</bpmn:incoming>
      <bpmn:outgoing>ST_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ST_s3" name="수업 참여·시험 응시">
      <bpmn:documentation>근거: S04 P048–061</bpmn:documentation>
      <bpmn:incoming>ST_f2</bpmn:incoming>
      <bpmn:incoming>ST_f6</bpmn:incoming>
      <bpmn:incoming>ST_f8</bpmn:incoming>
      <bpmn:incoming>ST_f12</bpmn:incoming>
      <bpmn:incoming>ST_f16</bpmn:incoming>
      <bpmn:outgoing>ST_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ST_s4" name="진행 중 사건/상태?" default="ST_f16">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f3</bpmn:incoming>
      <bpmn:outgoing>ST_f4</bpmn:outgoing>
      <bpmn:outgoing>ST_f7</bpmn:outgoing>
      <bpmn:outgoing>ST_f9</bpmn:outgoing>
      <bpmn:outgoing>ST_f14</bpmn:outgoing>
      <bpmn:outgoing>ST_f15</bpmn:outgoing>
      <bpmn:outgoing>ST_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ST_s6" name="공결 처리 결과 확인">
      <bpmn:documentation>근거: S04 P118–119
신청만으로 출석 인정하지 않고 담당자의 승인 시수를 사용.</bpmn:documentation>
      <bpmn:incoming>ST_f5</bpmn:incoming>
      <bpmn:outgoing>ST_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ST_s7" name="강의·출결 문제&#10;해당 대학에 문의">
      <bpmn:documentation>근거: W02 4.나.3; S04 P059–060</bpmn:documentation>
      <bpmn:incoming>ST_f7</bpmn:incoming>
      <bpmn:outgoing>ST_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ST_s9" name="교류 전체 취소 완료?" default="ST_f13">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f10</bpmn:incoming>
      <bpmn:outgoing>ST_f11</bpmn:outgoing>
      <bpmn:outgoing>ST_f12</bpmn:outgoing>
      <bpmn:outgoing>ST_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ST_s12" name="학적 예외 · 수학 상태 확인">
      <bpmn:documentation>근거: W01 제8·16·18조; W02 4.다.2</bpmn:documentation>
      <bpmn:incoming>ST_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ST_s8" name="취소 절차 수행&#10;양교 처리 결과 확인">
      <bpmn:documentation>근거: S02; W01 제12조; S04 P117
취소 요청만으로 현재 수강을 중단하는 모델이 아니다. 05에서 처리 완료가 확인되어야 한다.</bpmn:documentation>
      <bpmn:incoming>ST_f9</bpmn:incoming>
      <bpmn:outgoing>ST_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ST_f1" sourceRef="ST_s0" targetRef="ST_s2" />
    <bpmn:sequenceFlow id="ST_f2" sourceRef="ST_s2" targetRef="ST_s3" />
    <bpmn:sequenceFlow id="ST_f6" name="결과 확인 후" sourceRef="ST_s6" targetRef="ST_s3" />
    <bpmn:sequenceFlow id="ST_f8" name="확인 후" sourceRef="ST_s7" targetRef="ST_s3" />
    <bpmn:sequenceFlow id="ST_f12" name="유효 과목 수학 계속" sourceRef="ST_s9" targetRef="ST_s3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">유효 과목 수학 계속</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f16" sourceRef="ST_s4" targetRef="ST_s3" />
    <bpmn:sequenceFlow id="ST_f3" sourceRef="ST_s3" targetRef="ST_s4" />
    <bpmn:sequenceFlow id="ST_f4" name="공결 사유" sourceRef="ST_s4" targetRef="ST_s5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">공결 사유</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f7" name="강의·출결 문의" sourceRef="ST_s4" targetRef="ST_s7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">강의·출결 문의</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f9" name="취소 의사" sourceRef="ST_s4" targetRef="ST_s8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">취소 의사</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f14" name="학적 예외 발생" sourceRef="ST_s4" targetRef="ST_s12">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">학적 예외 발생</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f15" name="수업·시험 마침" sourceRef="ST_s4" targetRef="ST_s13">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">수업·시험 마침</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f5" sourceRef="ST_s5" targetRef="ST_s6" />
    <bpmn:sequenceFlow id="ST_f10" sourceRef="ST_s8" targetRef="ST_s9" />
    <bpmn:sequenceFlow id="ST_f11" name="전체 취소 완료" sourceRef="ST_s9" targetRef="ST_s10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">전체 취소 완료</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ST_f13" name="상태 미확정" sourceRef="ST_s9" targetRef="ST_s14" />
    <bpmn:userTask id="ST_s5" name="공결 사유 발생 후&#10;7일 이내 포털 신청">
      <bpmn:documentation>근거: S04 P118–119; W04 출석인정
포털 수업/성적 → 출석인정 신청. 일반 안내는 토요일·공휴일 제외 7일 및 증빙 첨부를 명시한다. 교류생의 승인 경로·해당 시점 적용 규정은 교육혁신과에서 G08 확인. 달력일 7일 자동 반려 없음.</bpmn:documentation>
      <bpmn:incoming>ST_f4</bpmn:incoming>
      <bpmn:outgoing>ST_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_s13" name="수업·시험 종료">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ST_s10" name="취소 종료">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ST_s14" name="취소 상태 미확정&#10;담당확인 인계">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f13</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="ST_H_process" name="04 수업·시험·공결·시설 / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>수업 기간 중 발생하는 공결과 취소 신청을 처리한다. 시설 이용과 일반 추가시험 안내는 수업 절차에 참고한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="ST_H_lanes">
      <bpmn:lane id="ST_H_lane0" name="학적·교류 담당">
        <bpmn:flowNodeRef>ST_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_h1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_h2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ST_h0" name="학칙 위반 사안 발생">
      <bpmn:documentation>근거: W01 제16조</bpmn:documentation>
      <bpmn:outgoing>ST_f17</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ST_h1" name="수학허가 유지·취소 판단">
      <bpmn:documentation>근거: W01 제16·18조
담당 판단·승인: G09. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
수학대학 학칙 위반이 발생한 경우 허가 취소가 가능하다. 실제 권한 분장과 통지 경로는 공개 근거에서 확인되지 않았다.</bpmn:documentation>
      <bpmn:incoming>ST_f17</bpmn:incoming>
      <bpmn:outgoing>ST_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_h2" name="수학허가 판단 결과">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ST_f17" sourceRef="ST_h0" targetRef="ST_h1" />
    <bpmn:sequenceFlow id="ST_f18" sourceRef="ST_h1" targetRef="ST_h2" />
  </bpmn:process>
  <bpmn:process id="ST_J_process" name="04 수업·시험·공결·시설 / 교류대 · 제주대학교" isExecutable="false">
    <bpmn:documentation>수업 기간 중 발생하는 공결과 취소 신청을 처리한다. 시설 이용과 일반 추가시험 안내는 수업 절차에 참고한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="ST_J_lanes">
      <bpmn:lane id="ST_J_lane1" name="교육혁신과·공결 담당">
        <bpmn:flowNodeRef>ST_j5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ST_J_lane0" name="과목 개설 학과·담당교원">
        <bpmn:flowNodeRef>ST_j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_j4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ST_j0" name="수학 개시">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>ST_f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ST_j0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="ST_j1" name="강의·시험 실시&#10;과목별 일정 안내">
      <bpmn:documentation>근거: S04 P048–061</bpmn:documentation>
      <bpmn:incoming>ST_f19</bpmn:incoming>
      <bpmn:outgoing>ST_f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="ST_j2" name="확정 출석시수 확인">
      <bpmn:documentation>근거: S04 P051
DMN 참조: D09 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)</bpmn:documentation>
      <bpmn:incoming>ST_f20</bpmn:incoming>
      <bpmn:outgoing>ST_f21</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="ST_j3" name="절대평가로 성적 산정&#10;06 열람·이의신청으로">
      <bpmn:documentation>근거: S04 P062–069
담당 판단·승인: G08. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
출석 요건 충족만으로 학점/합격을 자동 부여하지 않는다. 과목별 평가 기준·성적은 담당교원이 확정.</bpmn:documentation>
      <bpmn:incoming>ST_f21</bpmn:incoming>
      <bpmn:outgoing>ST_f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_j4" name="성적 처리 단계로">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ST_j5" name="공결 신청">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>ST_f23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ST_j5_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="ST_j6" name="사유·기한·증빙 심사&#10;출석 인정 여부·시수 결정">
      <bpmn:documentation>근거: S04 P118–119; W04 출석인정
담당 판단·승인: G08. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
일반 안내에는 인정 사유, 증빙(보건결석 예외), 토요일·공휴일 제외 7일, 학과장 경유 대학장 승인, 인정시수 1/4 및 교육실습 예외가 있음. 교류생의 적용 승인 경로와 당시 규정 버전을 확인하고 결정. 단순 신청은 승인 아님.</bpmn:documentation>
      <bpmn:incoming>ST_f23</bpmn:incoming>
      <bpmn:outgoing>ST_f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_j8" name="공결 판단 결과">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>ST_f24</bpmn:incoming>
    </bpmn:endEvent>
