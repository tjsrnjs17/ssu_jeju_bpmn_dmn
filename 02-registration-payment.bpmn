        <bpmn:flowNodeRef>RE_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s5g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE_s9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="RE_s0" name="선발·학번 확인됨">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>RE_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="RE_s1" name="학번으로 로그인&#10;본인 휴대폰 비번 설정">
      <bpmn:documentation>근거: S04 P025–027; S05 A23</bpmn:documentation>
      <bpmn:incoming>RE_f1</bpmn:incoming>
      <bpmn:outgoing>RE_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RE_s2" name="승인 과목 선착순 신청">
      <bpmn:documentation>근거: W01 제11조; S04 P021–029
sugang.jejunu.ac.kr. 6학점 이내. 제한 교과목은 D03. 수강 좌석을 보장하지 않음.</bpmn:documentation>
      <bpmn:incoming>RE_f2</bpmn:incoming>
      <bpmn:outgoing>RE_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RE_s3" name="1차 폐강 확인">
      <bpmn:documentation>근거: S04 P030–033</bpmn:documentation>
      <bpmn:incoming>RE_f3</bpmn:incoming>
      <bpmn:outgoing>RE_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RE_s4" name="삭제·추가·변경 필요?" default="RE_f6">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f4</bpmn:incoming>
      <bpmn:outgoing>RE_f5</bpmn:outgoing>
      <bpmn:outgoing>RE_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RE_s5" name="승인 과목 추가신청">
      <bpmn:documentation>근거: W01 제11조; W02 4.나.4; S04 P034–039
5/28 10시–5/29 18시. 새 과목은 수강신청 전에 03의 재제출·승인 절차를 적용한다.</bpmn:documentation>
      <bpmn:incoming>RE_f5</bpmn:incoming>
      <bpmn:outgoing>RE_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RE_s5g" name="유효 등록 과목 있음?" default="RE_f10">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f6</bpmn:incoming>
      <bpmn:incoming>RE_f7</bpmn:incoming>
      <bpmn:outgoing>RE_f8</bpmn:outgoing>
      <bpmn:outgoing>RE_f9</bpmn:outgoing>
      <bpmn:outgoing>RE_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RE_s6" name="고지서 출력&#10;제주대에 직접 납부">
      <bpmn:documentation>근거: S04 P070–097; W01 제14조
DMN 참조: D06 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)
6/4 10시–6/9 17시. 창구는 은행 마감까지. NH 수납창구/가상계좌/전자금융. 포털 통합정보 등록관리에서 고지서 조회.</bpmn:documentation>
      <bpmn:incoming>RE_f8</bpmn:incoming>
      <bpmn:outgoing>RE_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RE_s8" name="납부 결과?" default="RE_f15">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f12</bpmn:incoming>
      <bpmn:outgoing>RE_f13</bpmn:outgoing>
      <bpmn:outgoing>RE_f14</bpmn:outgoing>
      <bpmn:outgoing>RE_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RE_s15" name="납부·등록 결과 미확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f15</bpmn:incoming>
      <bpmn:incoming>RE_f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="RE_s10" name="최종 폐강 확인&#10;6/11 예정">
      <bpmn:documentation>근거: S04 P045–047</bpmn:documentation>
      <bpmn:incoming>RE_f14</bpmn:incoming>
      <bpmn:outgoing>RE_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RE_s11" name="남은 유효 과목 있음?" default="RE_f19">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f16</bpmn:incoming>
      <bpmn:outgoing>RE_f17</bpmn:outgoing>
      <bpmn:outgoing>RE_f18</bpmn:outgoing>
      <bpmn:outgoing>RE_f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RE_s16" name="등록 결과 미확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>RE_f10</bpmn:incoming>
