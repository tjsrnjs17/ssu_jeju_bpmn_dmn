<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_GR" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="GR_Collaboration" name="06 성적 확인·송부·본교 인정">
    <bpmn:documentation>As-Is 규정 모델. 06 성적 확인·송부·본교 인정
제주대는 절대평가한 백분위 실점수를 공식 송부한다. 본교 성적 환산·개별 인정 판단을 담당확인으로 남기며 파견명단의 이수 여부와 인정 여부를 구분한다.
주황색은 담당자의 승인 또는 판단 단계. I번호 주석은 인터뷰 확인 사항. 참고 BPMN은 근거에서 제외.</bpmn:documentation>
    <bpmn:participant id="GR_S" name="학생" processRef="GR_S_process" />
    <bpmn:participant id="GR_H" name="본교 · 숭실대학교" processRef="GR_H_process" />
    <bpmn:participant id="GR_J" name="교류대 · 제주대학교" processRef="GR_J_process" />
    <bpmn:messageFlow id="GR_m1" name="포털 성적 조회" sourceRef="GR_j1" targetRef="GR_s1" />
    <bpmn:messageFlow id="GR_m2" name="성적 이의신청" sourceRef="GR_s3" targetRef="GR_j3" />
    <bpmn:messageFlow id="GR_m3" name="정정/유지 결과" sourceRef="GR_j3" targetRef="GR_s4" />
    <bpmn:messageFlow id="GR_m4" name="공식 성적 자료" sourceRef="GR_j7" targetRef="GR_h0" />
    <bpmn:messageFlow id="GR_m5" name="반영된 성적표 조회" sourceRef="GR_h6" targetRef="GR_s6" />
    <bpmn:textAnnotation id="GR_h1_InterviewNote">
      <bpmn:text>I30 · 인터뷰 확인
사전 승인받은 과목을 그대로 이수했다면, 성적을 받은 뒤 학
과의 별도 학점인정 심사를 거쳐야 하나요?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="GR_h1_InterviewNote_association" associationDirection="None" sourceRef="GR_h1" targetRef="GR_h1_InterviewNote" />
  </bpmn:collaboration>
  <bpmn:process id="GR_S_process" name="06 성적 확인·송부·본교 인정 / 학생" isExecutable="false">
    <bpmn:documentation>제주대는 절대평가한 백분위 실점수를 공식 송부한다. 본교 성적 환산·개별 인정 판단을 담당확인으로 남기며 파견명단의 이수 여부와 인정 여부를 구분한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="GR_S_lanes">
      <bpmn:lane id="GR_S_lane0" name="수학 결과 확인">
        <bpmn:flowNodeRef>GR_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_s7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GR_s0" name="수업·시험 종료">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>GR_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="GR_s1" name="성적 열람">
      <bpmn:documentation>근거: S04 P062–065
포털 통합정보 → 수업/성적 → 성적관리 → 성적조회.</bpmn:documentation>
      <bpmn:incoming>GR_f1</bpmn:incoming>
      <bpmn:outgoing>GR_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GR_s2" name="성적 이의신청?" default="GR_f6">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f2</bpmn:incoming>
      <bpmn:outgoing>GR_f3</bpmn:outgoing>
      <bpmn:outgoing>GR_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="GR_s3" name="정해진 기간에&#10;성적 이의신청">
      <bpmn:documentation>근거: S04 P062–065
상세 증빙·접수 방법·교원 처리 기한은 안내문 미제시: G08 담당확인.</bpmn:documentation>
      <bpmn:incoming>GR_f3</bpmn:incoming>
      <bpmn:outgoing>GR_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="GR_s4" name="이의신청 처리&#10;결과 확인">
      <bpmn:documentation>근거: S04 P062–065</bpmn:documentation>
      <bpmn:incoming>GR_f4</bpmn:incoming>
      <bpmn:outgoing>GR_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="GR_s6" name="공식 송부·본교 성적&#10;인정 결과 확인">
      <bpmn:documentation>근거: S04 P066–069·P120–121; W01 제13조
제주대 총장 명의 성적증명서 발급 불가. 학생 개인 증명서 제출을 필수 경로로 만들지 않음. 8/5 이전 조기 송부 불가.</bpmn:documentation>
      <bpmn:incoming>GR_f5</bpmn:incoming>
      <bpmn:incoming>GR_f6</bpmn:incoming>
      <bpmn:outgoing>GR_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="GR_s7" name="학점·성적 결과 확인">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GR_f1" sourceRef="GR_s0" targetRef="GR_s1" />
    <bpmn:sequenceFlow id="GR_f2" sourceRef="GR_s1" targetRef="GR_s2" />
    <bpmn:sequenceFlow id="GR_f3" name="신청" sourceRef="GR_s2" targetRef="GR_s3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">신청</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GR_f6" name="없음" sourceRef="GR_s2" targetRef="GR_s6" />
    <bpmn:sequenceFlow id="GR_f4" sourceRef="GR_s3" targetRef="GR_s4" />
    <bpmn:sequenceFlow id="GR_f5" sourceRef="GR_s4" targetRef="GR_s6" />
    <bpmn:sequenceFlow id="GR_f7" sourceRef="GR_s6" targetRef="GR_s7" />
  </bpmn:process>
  <bpmn:process id="GR_H_process" name="06 성적 확인·송부·본교 인정 / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>제주대는 절대평가한 백분위 실점수를 공식 송부한다. 본교 성적 환산·개별 인정 판단을 담당확인으로 남기며 파견명단의 이수 여부와 인정 여부를 구분한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="GR_H_lanes">
      <bpmn:lane id="GR_H_lane0" name="학사팀·학점인정 담당">
        <bpmn:flowNodeRef>GR_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_h13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GR_h0" name="제주대 공식 성적 수신">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>GR_f8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="GR_h0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="GR_h1" name="사전 승인·성적 대조&#10;인정·환산 검토">
      <bpmn:documentation>근거: W01 제10·11·13조; W02 4.가.2·4.다; W03 제24조·제24조의2; S01 K11
담당 판단·승인: G03·G10. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
기존 승인 및 이수구분을 공식 성적과 대조하고 실제 인정 학점·환산 기준을 확인한다. 대응 과목 없음의 일반선택 기준을 적용한다. 백분위 실점수의 본교 등급 환산 방식과 성적 수신 후 별도 학과 심사 유무는 문서에 명시되지 않았다. 계절제는 전체 성적에 합산하고 정규학기 성적·학기별 석차와 구분한다.</bpmn:documentation>
      <bpmn:incoming>GR_f8</bpmn:incoming>
      <bpmn:outgoing>GR_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="GR_h4" name="실제 학점·성적&#10;반영 경로 확인">
      <bpmn:documentation>근거: W01 제10·11·13조; W02 4.가; S03
DMN 참조: D02 D10 (동봉 credit-exchange-asis.dmn; 명시 규칙의 표현이며 현재 자동화 여부는 확인되지 않음)</bpmn:documentation>
      <bpmn:incoming>GR_f9</bpmn:incoming>
      <bpmn:outgoing>GR_f10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GR_h5" name="반영 결과?" default="GR_f13">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f10</bpmn:incoming>
      <bpmn:outgoing>GR_f11</bpmn:outgoing>
      <bpmn:outgoing>GR_f12</bpmn:outgoing>
      <bpmn:outgoing>GR_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="GR_h6" name="인정 학점·성적 반영&#10;교환과목 표시">
      <bpmn:documentation>근거: W01 제13조; W03 제24조·제24조의2</bpmn:documentation>
      <bpmn:incoming>GR_f11</bpmn:incoming>
      <bpmn:outgoing>GR_f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="GR_h9" name="자료·기준 미확정&#10;반영 보류">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="GR_h10" name="파견명단 J: 실제 이수&#10;K: 실제 인정 작성">
      <bpmn:documentation>근거: S03 J1·K1
학기 말 학사팀 작성. 실제 이수와 본교 인정은 별개 항목이다. 미인정·미이수와 확인된 미납·취소도 실제 범위로 작성한다.</bpmn:documentation>
      <bpmn:incoming>GR_f12</bpmn:incoming>
      <bpmn:incoming>GR_f14</bpmn:incoming>
      <bpmn:incoming>GR_f16</bpmn:incoming>
      <bpmn:outgoing>GR_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="GR_h12" name="학적·파견명단 정리">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GR_f8" sourceRef="GR_h0" targetRef="GR_h1" />
    <bpmn:sequenceFlow id="GR_f9" sourceRef="GR_h1" targetRef="GR_h4" />
    <bpmn:sequenceFlow id="GR_f10" sourceRef="GR_h4" targetRef="GR_h5" />
    <bpmn:sequenceFlow id="GR_f11" name="인정 확정" sourceRef="GR_h5" targetRef="GR_h6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">인정 확정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GR_f12" name="미인정 확정" sourceRef="GR_h5" targetRef="GR_h10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">미인정 확정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GR_f13" name="미확정" sourceRef="GR_h5" targetRef="GR_h9" />
    <bpmn:sequenceFlow id="GR_f14" sourceRef="GR_h6" targetRef="GR_h10" />
    <bpmn:sequenceFlow id="GR_f16" sourceRef="GR_h13" targetRef="GR_h10" />
    <bpmn:sequenceFlow id="GR_f15" sourceRef="GR_h10" targetRef="GR_h12" />
    <bpmn:startEvent id="GR_h13" name="취소·미납 결과 확인됨">
      <bpmn:documentation>근거: S03 J1·K1; S04 P043·P117</bpmn:documentation>
      <bpmn:outgoing>GR_f16</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="GR_J_process" name="06 성적 확인·송부·본교 인정 / 교류대 · 제주대학교" isExecutable="false">
    <bpmn:documentation>제주대는 절대평가한 백분위 실점수를 공식 송부한다. 본교 성적 환산·개별 인정 판단을 담당확인으로 남기며 파견명단의 이수 여부와 인정 여부를 구분한다. 문서 기반 서술 모델. 미확정 끝 이벤트는 확인된 절차의 범위를 나타낸다.</bpmn:documentation>
    <bpmn:laneSet id="GR_J_lanes">
      <bpmn:lane id="GR_J_lane1" name="교육혁신과·성적 담당">
        <bpmn:flowNodeRef>GR_j7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_j8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GR_J_lane0" name="과목 개설 학과·담당교원">
        <bpmn:flowNodeRef>GR_j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR_j4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GR_j0" name="성적 산정 완료">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>GR_f17</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="GR_j1" name="성적 열람·&#10;이의신청 기간 운영">
      <bpmn:documentation>근거: S04 P062–065</bpmn:documentation>
      <bpmn:incoming>GR_f17</bpmn:incoming>
      <bpmn:outgoing>GR_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GR_j2" name="기간 내 이의신청?" default="GR_f20">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>GR_f18</bpmn:incoming>
      <bpmn:outgoing>GR_f19</bpmn:outgoing>
      <bpmn:outgoing>GR_f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="GR_j3" name="담당교원 검토&#10;정정/유지 결과 처리">
      <bpmn:documentation>근거: S04 P062–065; W01 제13조
담당 판단·승인: G08. 세부 적용 기준은 해당 규정과 자료에서 확인한다.</bpmn:documentation>
      <bpmn:incoming>GR_f19</bpmn:incoming>
      <bpmn:outgoing>GR_f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="GR_j4" name="절대평가 결과 확정&#10;백분위 실점수 정리">
      <bpmn:documentation>근거: S04 P068–069</bpmn:documentation>
      <bpmn:incoming>GR_f20</bpmn:incoming>
      <bpmn:incoming>GR_f21</bpmn:incoming>
      <bpmn:outgoing>GR_f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="GR_j7" name="본교로 공식 성적&#10;백분위 실점수 송부">
      <bpmn:documentation>근거: S04 P066–069·P120–126
8/5 예정일 이전에는 송부 불가. 시설 미반납·미납은 송부 지연 가능 사유다. 본교 절차는 실제 공식 성적 수신으로 시작한다.</bpmn:documentation>
      <bpmn:incoming>GR_f22</bpmn:incoming>
