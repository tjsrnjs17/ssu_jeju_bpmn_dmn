<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_CA" targetNamespace="https://example.org/ssu-jeju/2026/asis" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="CA_Collaboration" name="05 교류 취소·수강료 환불 / 최종 As-Is">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:participant id="CA_S" name="학생" processRef="CA_S_process" />
    <bpmn:participant id="CA_H" name="본교 · 숭실대학교" processRef="CA_H_process" />
    <bpmn:participant id="CA_J" name="교류대 · 제주대학교" processRef="CA_J_process" />
    <bpmn:messageFlow id="CA_m1" name="포털 취소·환불 신청" sourceRef="CA_s1" targetRef="CA_j0" />
    <bpmn:messageFlow id="CA_m2" name="본교 취소신청서" sourceRef="CA_s1" targetRef="CA_h0" />
    <bpmn:messageFlow id="CA_m3" name="취소 요청 공문" sourceRef="CA_h4" targetRef="CA_j5" />
    <bpmn:messageFlow id="CA_m4" name="실제 처리 결과" sourceRef="CA_j5" targetRef="CA_s4" />
    <bpmn:messageFlow id="CA_m5" name="사후 민원" sourceRef="CA_sLate" targetRef="CA_hLate0" />
    <bpmn:messageFlow id="CA_m6" name="취소·성적 무효화 요청" sourceRef="CA_hLateRequest" targetRef="CA_jLate0" />
    <bpmn:messageFlow id="CA_m7" name="실제 처리 결과" sourceRef="CA_jLateReply" targetRef="CA_hLateResult" />
    <bpmn:messageFlow id="CA_m8" name="확인된 결과" sourceRef="CA_hLateNotify" targetRef="CA_sLateResult" />
  </bpmn:collaboration>
  <bpmn:process id="CA_S_process" name="05 교류 취소·수강료 환불 / 최종 As-Is / 학생" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="CA_S_lanes">
      <bpmn:lane id="CA_S_lane0" name="정상 취소·환불 신청">
        <bpmn:flowNodeRef>CA_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_sPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_s8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CA_S_lane1" name="사후 민원">
        <bpmn:flowNodeRef>CA_sLate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_sLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_sLateResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_sLateEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CA_s0" name="취소 의사 발생">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CA_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CA_s4" name="수강취소·환불 및&#10;공문 처리 결과 확인">
      <bpmn:documentation>근거: S04 P117
실제로 확인된 처리 범위를 사용한다. 일부 과목 취소 시 남은 유효 과목은 04에 따른다.</bpmn:documentation>
      <bpmn:incoming>CA_f2</bpmn:incoming>
      <bpmn:incoming>CA_f19</bpmn:incoming>
      <bpmn:outgoing>CA_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CA_s7" name="신청 범위 처리 완료?" default="CA_f18">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f3</bpmn:incoming>
      <bpmn:outgoing>CA_f4</bpmn:outgoing>
      <bpmn:outgoing>CA_f17</bpmn:outgoing>
      <bpmn:outgoing>CA_f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CA_s9" name="취소 불가 확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CA_sPending" name="처리 결과 확인 대기">
      <bpmn:documentation>근거: 양교의 실제 처리 결과</bpmn:documentation>
      <bpmn:incoming>CA_f18</bpmn:incoming>
      <bpmn:outgoing>CA_f19</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CA_sPending_condition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">취소·환불·공문 처리 결과가 확인됨</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="CA_sLate0" name="수강 방치 후 F 등&#10;사후 민원 발생">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CA_f26</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="CA_sLate" name="본교 학사팀에&#10;취소·성적 관련 민원">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15</bpmn:documentation>
      <bpmn:incoming>CA_f26</bpmn:incoming>
      <bpmn:outgoing>CA_f27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="CA_sLateResult" name="확인된 처리 결과 확인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15
요청을 승인으로 간주하지 않는다. 승인된 범위만 취소·성적 결과에 적용한다.</bpmn:documentation>
      <bpmn:incoming>CA_f27</bpmn:incoming>
      <bpmn:outgoing>CA_f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CA_sLateEnd" name="06 실제 성적·명단 처리로">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CA_s1" name="제주대 포털 신청&#10;본교 취소신청서 제출">
      <bpmn:documentation>근거: S02 B6:K23·E31:E32; W01 제12조; S04 P098–117
제주대 포털 등록/장학 → 계절학기납부고지서출력 → 계절학기환불신청. 본교에는 취소 사유와 과목을 적은 신청서를 제출한다. 두 신청을 한 상자에 요약한다.</bpmn:documentation>
      <bpmn:incoming>CA_f1</bpmn:incoming>
      <bpmn:outgoing>CA_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CA_s8" name="취소 범위 확정">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CA_f1" sourceRef="CA_s0" targetRef="CA_s1" />
    <bpmn:sequenceFlow id="CA_f2" sourceRef="CA_s1" targetRef="CA_s4" />
    <bpmn:sequenceFlow id="CA_f19" sourceRef="CA_sPending" targetRef="CA_s4" />
    <bpmn:sequenceFlow id="CA_f3" sourceRef="CA_s4" targetRef="CA_s7" />
    <bpmn:sequenceFlow id="CA_f4" name="완료" sourceRef="CA_s7" targetRef="CA_s8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">완료</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CA_f17" name="불가 확정" sourceRef="CA_s7" targetRef="CA_s9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">불가 확정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CA_f18" name="미확정" sourceRef="CA_s7" targetRef="CA_sPending" />
    <bpmn:sequenceFlow id="CA_f26" sourceRef="CA_sLate0" targetRef="CA_sLate" />
    <bpmn:sequenceFlow id="CA_f27" sourceRef="CA_sLate" targetRef="CA_sLateResult" />
    <bpmn:sequenceFlow id="CA_f28" sourceRef="CA_sLateResult" targetRef="CA_sLateEnd" />
  </bpmn:process>
  <bpmn:process id="CA_H_process" name="05 교류 취소·수강료 환불 / 최종 As-Is / 본교 · 숭실대학교" isExecutable="false">
    <bpmn:documentation>최종 As-Is. 근거 우선순위: 2026-11-13 담당자 인터뷰의 실제 운영 설명 &gt; 기존 신청서·학칙·안내문. 인터뷰 미설명 사항은 해당 문서로 보완한다. 숭실대 수신 절차를 제주대 파견에 전용하지 않는다. 자동화·통합 시스템·일반선택 무승인 통과는 현행 흐름에 포함하지 않는다. 주황색은 전문 판단·승인, 파란색은 DMN으로 정리한 수동 확인 기준이다. 실행 엔진 배포용 모델이 아니다.</bpmn:documentation>
    <bpmn:laneSet id="CA_H_lanes">
      <bpmn:lane id="CA_H_lane0" name="학과 · 학과장">
        <bpmn:flowNodeRef>CA_h0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_h1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CA_H_lane1" name="학사팀 · 학점교류 담당">
        <bpmn:flowNodeRef>CA_h3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_h4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_h6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_hLate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_hLateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_hLateResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_hLateNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_hLateEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_h7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CA_h0" name="취소신청서 접수">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:outgoing>CA_f5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CA_h0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="CA_h1" name="취소신청서 확인&#10;학과장 서명">
      <bpmn:documentation>근거: S02 B11:K23·E32; W01 제12조; S04 P117
담당 판단·승인: G07. 세부 적용 기준은 해당 규정과 자료에서 확인한다.
신청서의 취소 과목·사유와 소정 제출 기한을 적용한다. 학기 중 취소는 수학대학 규정에 따른다. 수강신청 변경기간 이후 취소 승인을 받은 경우 본교 추가 수강신청 불가.</bpmn:documentation>
      <bpmn:incoming>CA_f5</bpmn:incoming>
      <bpmn:outgoing>CA_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CA_h3" name="본교 신청 요건 충족?" default="CA_f8">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f6</bpmn:incoming>
      <bpmn:incoming>CA_f25</bpmn:incoming>
      <bpmn:outgoing>CA_f7</bpmn:outgoing>
      <bpmn:outgoing>CA_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="CA_h4" name="제주대에&#10;취소 요청 공문 송부">
      <bpmn:documentation>근거: S04 P117; W01 제12조</bpmn:documentation>
      <bpmn:incoming>CA_f7</bpmn:incoming>
      <bpmn:outgoing>CA_f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="CA_h6" name="취소 공문 송부">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CA_hLate0" name="학생 사후 민원 접수">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15</bpmn:documentation>
      <bpmn:outgoing>CA_f29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CA_hLate0_message" />
    </bpmn:startEvent>
    <bpmn:sendTask id="CA_hLateRequest" name="타교에 수강취소·&#10;성적 무효화 요청">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15
인터뷰로 확인된 실제 사후 요청이다. 정규 환불기한을 연장하거나 성적을 자동 무효화하지 않는다.</bpmn:documentation>
      <bpmn:incoming>CA_f29</bpmn:incoming>
      <bpmn:outgoing>CA_f30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="CA_hLateResult" name="타교의 실제 처리 결과 확인">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15; S04
제주대의 수락 여부·처리 범위를 실제 확인한다. 확정되기 전에는 기존 성적·수강 상태를 임의로 바꾸지 않는다.</bpmn:documentation>
      <bpmn:incoming>CA_f30</bpmn:incoming>
      <bpmn:outgoing>CA_f31</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="CA_hLateNotify" name="학생에게 결과 전달&#10;성적·명단 처리에 인계">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 Q15; S03
거절이면 기존 유효 성적을 적용하고, 정정되면 공식 정정 결과를 06에서 사용한다.</bpmn:documentation>
      <bpmn:incoming>CA_f31</bpmn:incoming>
      <bpmn:outgoing>CA_f32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="CA_hLateEnd" name="사후 요청 결과 인계">
      <bpmn:documentation>근거: 앞뒤 문서상 단계의 흐름을 표현하는 모델 제어 요소</bpmn:documentation>
      <bpmn:incoming>CA_f32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CA_h7" name="본교 신청 결과 확인 대기">
      <bpmn:documentation>근거: I20261113 학사팀 학점교류 담당자 인터뷰 또는 해당 문서상 결과 확인
사실이 확인될 때까지 대기한다. 자동 조회·독촉 주기는 가정하지 않는다.</bpmn:documentation>
      <bpmn:incoming>CA_f8</bpmn:incoming>
      <bpmn:outgoing>CA_f25</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CA_h7_condition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" language="urn:ssu-jeju:descriptive-condition">본교 취소신청의 요건·처리 결과가 확인됨</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="CA_f5" sourceRef="CA_h0" targetRef="CA_h1" />
    <bpmn:sequenceFlow id="CA_f6" sourceRef="CA_h1" targetRef="CA_h3" />
    <bpmn:sequenceFlow id="CA_f25" sourceRef="CA_h7" targetRef="CA_h3" />
