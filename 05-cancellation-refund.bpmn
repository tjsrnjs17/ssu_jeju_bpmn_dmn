        <bpmn:flowNodeRef>CA_jPending</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CA_J_lane1" name="사후 취소·성적 처리 담당">
        <bpmn:flowNodeRef>CA_jLate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_jLateReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_jLateReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_jLateEnd</bpmn:flowNodeRef>
      </bpmn:lane>
